  "widgets": [
    {
      "id": "detection",
      "title": "Detection",
      "width": "third",
      "kind": "platform",
      "source": "openaev",
      "view": "donut",
      "size": "m",
      "native": {
        "widget_type": "donut",
        "widget_config": {
          "widget_configuration_type": "structural-histogram",
          "title": "Detection",
          "time_range": "DEFAULT",
          "date_attribute": "base_created_at",
          "series": [
            {
              "name": "",
              "filter": {
                "mode": "and",
                "filters": [
                  {
                    "key": "base_entity",
                    "values": [
                      "expectation-inject"
                    ],
                    "operator": "eq",
                    "mode": "or"
                  },
                  {
                    "key": "inject_expectation_type",
                    "values": [
                      "DETECTION"
                    ],
                    "operator": "eq",
                    "mode": "or"
                  }
                ]
              }
            }
          ],
          "mode": "structural",
          "field": "inject_expectation_status",
          "limit": 100,
          "stacked": false,
          "display_legend": false
        }
      }
    },
