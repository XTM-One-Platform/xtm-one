{
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "description": "One entry per CVE assessed, in the order received",
      "items": {
        "type": "object",
        "properties": {
          "cve": {"type": "string", "description": "The CVE id, e.g. CVE-2026-1234"},
          "opencti_id": {"type": ["string", "null"], "description": "The OpenCTI id of the Vulnerability"},
          "match": {"type": "string", "enum": ["matched", "not_applicable", "unknown"]},
          "matched_assets": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Software products or OpenCRQ assets running the affected software"
          },
          "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "Finding score; null when not matched"},
          "score_terms": {
            "type": "object",
            "properties": {
              "epss": {"type": ["number", "null"]},
              "kev": {"type": ["boolean", "null"]},
              "threat_citation": {"type": ["string", "null"]},
              "sighted": {"type": ["boolean", "null"]},
              "asset_criticality": {"type": ["string", "null"]},
              "measured_resistance": {"type": ["string", "null"]}
            }
          },
          "exploitation": {
            "type": "array",
            "description": "From get_opencrq_cve_exploitation, one entry per OpenCRQ asset reached; empty when OpenCRQ is not bound",
            "items": {
              "type": "object",
              "properties": {
                "risk_scenario_id": {"type": "string"},
                "asset": {"type": "string"},
                "exposure": {"type": "string"},
                "techniques": {"type": "array", "items": {"type": "string"}, "description": "ATT&CK ids in attack order"},
                "reading": {"type": "string", "description": "Why these techniques: a mapping naming the CVE, or the topology rule line"}
              },
              "required": ["asset", "techniques", "reading"]
            }
          },
          "attack_path": {
            "type": ["object", "null"],
            "description": "From get_opencrq_attack_path_reach on the matched asset with the highest impact; null when OpenCRQ is not bound",
            "properties": {
              "origin": {"type": "object", "properties": {"asset": {"type": "string"}, "exposure": {"type": "string"}}},
              "hops": {"type": "array", "description": "Nearest first", "items": {"type": "object", "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "nature": {"type": "string", "enum": ["proven", "inferred"]}, "simulation": {"type": ["string", "null"], "description": "The simulation id, kept for the trace"}, "simulation_name": {"type": ["string", "null"]}, "simulation_url": {"type": ["string", "null"]}, "seen_at": {"type": ["string", "null"], "description": "The hop's last reported date"}}}},
              "reached": {"type": "array", "items": {"type": "object", "properties": {"asset": {"type": "string"}, "depth": {"type": "integer"}, "criticality": {"type": ["string", "null"]}}}},
              "primary": {"type": "array", "items": {"type": "string"}}
            }
          },
          "reason": {"type": "string", "description": "One sentence: why matched, or why closed not applicable"},
          "context_fields_used": {"type": "array", "items": {"type": "string"}},
          "context_fields_missing": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["cve", "match", "matched_assets", "score", "reason"]
      }
    }
  },
  "required": ["findings"]
}
