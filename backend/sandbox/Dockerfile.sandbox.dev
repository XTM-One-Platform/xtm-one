# Development sandbox images for OpenSandbox (commands.run() mode): the
# toolchains an agent needs to run THIS repository's own checks on a checkout
# in its workspace (sandbox_run_command, .xtm-one/checks.toml), with the
# repository's LOCKED dependencies installed at build time, so a check runs
# offline against exactly what CI runs.
#
# Two final targets, built from the repository root as context (the lock
# files live in backend/ and frontend/), by backend/sandbox/build-dev-image.sh;
# not entries of sandbox-images.json, whose images build from backend/sandbox:
#
#   python-dev  - Python 3.14 + the backend's uv.lock (dev group: pytest,
#                 ruff, mypy, vulture) in /opt/venv, git, the data
#                 stores of the backend's integration tests under
#                 /opt/stores (PostgreSQL 16 + pgvector, Dragonfly, Silo;
#                 .xtm-one/stores.py), Playwright's headless
#                 Chromium under /ms-playwright (the lab's presentation
#                 export) and tiktoken's cl100k_base encoding under
#                 /opt/tiktoken (TIKTOKEN_CACHE_DIR). Non-root.
#   nodejs-dev  - Node 24 + yarn (corepack, the version package.json pins)
#                 with the frontend's yarn.lock fully in the yarn global cache,
#                 so `yarn install --immutable` in a checkout links node_modules
#                 offline. git. A bare CPython interpreter reachable as
#                 `python` (no pip): the platform's workspace helper. Non-root.
#
# Hardening (dev-docs/sandbox-image-hardening.md): compilers and *-dev headers
# stay in the builder stages (rule 1); git is the one runtime CLI exception of
# both targets, named in apt.sandbox.dev.runtime.txt (rule 2); nodejs-dev's
# second one is the CPython interpreter, named in its stage below (rule 2:
# sandbox_workspace/remote.py runs its helper as `python /tmp/.xtm/ws_tool.py`
# in every command container, before and after the check); every FROM is
# digest-pinned (rule 3); both targets run as a non-root user (rule 4). Neither
# ships uv, npm's registry access or a package manager an agent could reach the
# network with: the container has no network, and a check that tries the
# package index fails with a connection error.
#
# Usage:
#   backend/sandbox/build-dev-image.sh python-dev sandbox-python-dev:<version>
#   backend/sandbox/build-dev-image.sh nodejs-dev sandbox-nodejs-dev:<version>
# then OPENSANDBOX_IMAGES="python-dev:sandbox-python-dev:<version>,nodejs-dev:sandbox-nodejs-dev:<version>"
# (and SANDBOX_CPU / SANDBOX_RAM per key: a test suite needs more than 128Mi).

# ---------------------------------------------------------------------------
# Stage 1: python-builder - the backend's locked environment. Never shipped.
# ---------------------------------------------------------------------------
FROM docker.io/library/python:3.14-slim@sha256:fbecd461fc72d21b2143c6eaba25143738079154a6d0ea3da3aec724f50eed4a AS python-builder

ARG APT_FILE=backend/sandbox/apt.sandbox.dev.txt

# The full build list (compilers, *-dev headers for the wheels uv.lock pins
# that have no cp314 binary): dropped with this stage.
COPY ${APT_FILE} /tmp/apt-packages.txt
RUN apt-get update \
    && grep -v '^\s*#' /tmp/apt-packages.txt | grep -v '^\s*$' \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.26@sha256:3d868e555f8f1dbc324afa005066cd11e1053fc4743b9808ca8025283e65efa5 /uv /usr/local/bin/

# Exactly the lock, dev group included, into /opt/venv: the project itself is
# never installed (backend/pyproject.toml: package = false), the checkout is
# what runs. --locked fails the build when pyproject.toml and uv.lock disagree,
# as CI and the platform images do.
WORKDIR /src
COPY backend/pyproject.toml backend/uv.lock ./
RUN for attempt in 1 2 3; do \
        UV_HTTP_TIMEOUT=30 UV_HTTP_RETRIES=5 UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON=/usr/local/bin/python3 \
            uv sync --locked --no-install-project --group dev --compile-bytecode --no-cache && exit 0; \
        echo "uv sync failed (attempt $attempt of 3)" >&2; \
        if [ "$attempt" -lt 3 ]; then sleep 60; fi; \
    done; \
    exit 1

# The tokenizer data the backend's chunking loads (tiktoken cl100k_base): its
# first use downloads it, which the dev container's missing network refuses,
# so the unit tests that count tokens would only pass in CI. Fetched once here
# with the locked tiktoken (it checks the file's sha256), copied into python-dev
# below under TIKTOKEN_CACHE_DIR.
RUN mkdir -p /opt/tiktoken \
    && TIKTOKEN_CACHE_DIR=/opt/tiktoken /opt/venv/bin/python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')" \
    && test -n "$(ls -A /opt/tiktoken)"

# ---------------------------------------------------------------------------
# Stage 1b: stores-fetch - the integration tests' data stores. Never shipped
# as such: only /opt/stores is copied out. .xtm-one/stores.py fetches each
# artefact by its pinned URL, checks its sha256 (a mismatch fails the build)
# and unpacks it; this is the only network the stores ever see.
# ---------------------------------------------------------------------------
FROM docker.io/library/python:3.14-slim@sha256:fbecd461fc72d21b2143c6eaba25143738079154a6d0ea3da3aec724f50eed4a AS stores-fetch

COPY .xtm-one/stores.py /tmp/stores.py
RUN python /tmp/stores.py install /opt/stores

# ---------------------------------------------------------------------------
# Stage 2: python-dev - Debian-slim, the venv, git, the stores. Non-root (sandboxuser).
# ---------------------------------------------------------------------------
FROM docker.io/library/python:3.14-slim@sha256:fbecd461fc72d21b2143c6eaba25143738079154a6d0ea3da3aec724f50eed4a AS python-dev

ARG RUNTIME_APT_FILE=backend/sandbox/apt.sandbox.dev.runtime.txt

COPY ${RUNTIME_APT_FILE} /tmp/runtime-apt-packages.txt
RUN apt-get update \
    && grep -v '^\s*#' /tmp/runtime-apt-packages.txt | grep -v '^\s*$' \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 sandboxuser && useradd -u 1000 -g sandboxuser -m sandboxuser

COPY --from=python-builder /opt/venv /opt/venv
# The tiktoken encoding fetched in python-builder: owned by root, read-only
# for sandboxuser, read offline through TIKTOKEN_CACHE_DIR.
COPY --from=python-builder /opt/tiktoken /opt/tiktoken
# The stores (hardening rule 2, a named runtime exception): a PostgreSQL 16
# server with pgvector, a Redis-API server (Dragonfly) and an S3 server
# (Silo), owned by root, executable by sandboxuser. The backend-integration
# check (.xtm-one/checks.toml) and the lab start them on loopback inside the
# check's own container, with no network; nothing else runs them.
COPY --from=stores-fetch /opt/stores /opt/stores
# actionlint (a static Go binary) for the detected actions-lint check, which a
# declared checkout gets too; PyYAML comes with the backend's venv.
COPY --from=docker.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 /usr/local/bin/actionlint /usr/local/bin/actionlint
ENV PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV="/opt/venv" \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_INDEX=1 \
    UV_OFFLINE=1 \
    TIKTOKEN_CACHE_DIR=/opt/tiktoken

# Headless Chromium for the lab (hardening rule 2, a named runtime exception):
# the presentation export (PDF, PPTX) and the other Playwright
# renderers of the backend launch it, and without it the lab's export answers
# 503. The headless shell of the Playwright release uv.lock pins (the one
# chromium.launch(headless=True) starts) and its OS libraries, installed at
# build time into a fixed world-readable path, as the platform's Dockerfile
# does, so sandboxuser finds it with no network. Owned by root. The dev image
# smoke test prints a PDF with it under --network none.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update \
    && playwright install --with-deps --only-shell chromium \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
RUN chown sandboxuser:sandboxuser /workspace

USER sandboxuser

# ---------------------------------------------------------------------------
# Stage 3: node-builder - the frontend's lock in the yarn global cache. Never
# shipped as such: only /opt/yarn (the cache) and /opt/corepack (the yarn
# release package.json pins) are copied out.
# ---------------------------------------------------------------------------
# Debian trixie, as python:3.14-slim: apt.sandbox.dev.runtime.txt names trixie
# packages (libmagic1t64), and the interpreter copied into nodejs-dev below
# links against trixie's glibc. node:24-slim is bookworm and fails both.
FROM docker.io/library/node:24-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446 AS node-builder

ENV COREPACK_HOME=/opt/corepack \
    YARN_ENABLE_GLOBAL_CACHE=true \
    YARN_GLOBAL_FOLDER=/opt/yarn

WORKDIR /src
COPY frontend/package.json frontend/yarn.lock frontend/.yarnrc.yml ./
# corepack installs the yarn release package.json names (its hash checked)
# into COREPACK_HOME; `yarn install --immutable` fills the global cache with
# every package yarn.lock pins. node_modules of this stage are not shipped: a
# checkout links its own from the cache, offline.
RUN corepack enable \
    && corepack install \
    && yarn --version \
    && yarn install --immutable --mode=skip-build

# ---------------------------------------------------------------------------
# Stage 4: nodejs-dev - Node 24, yarn from the corepack cache, the yarn global
# cache, git. Non-root (the image's own node user, 1000).
# ---------------------------------------------------------------------------
FROM docker.io/library/node:24-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446 AS nodejs-dev

ARG RUNTIME_APT_FILE=backend/sandbox/apt.sandbox.dev.runtime.txt

COPY ${RUNTIME_APT_FILE} /tmp/runtime-apt-packages.txt
RUN apt-get update \
    && grep -v '^\s*#' /tmp/runtime-apt-packages.txt | grep -v '^\s*$' \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-builder /opt/corepack /opt/corepack
COPY --from=node-builder /opt/yarn /opt/yarn

# The workspace helper's interpreter (hardening rule 2, a named runtime
# exception): sandbox_run_command puts the workspace in the container and reads
# it back with remote.TOOL_SRC, run as `python /tmp/.xtm/ws_tool.py` (stdlib
# only: fnmatch, hashlib, json, os, stat, tarfile). The interpreter, its
# shared library and its standard library are copied from the same
# digest-pinned python:3.14-slim as python-dev (rule 3; straight from the
# image, so building nodejs-dev never runs the backend's uv sync), with no apt
# and no index; pip, ensurepip and the test, tkinter and idle packages are
# dropped, so nothing in it installs a package. Debian's python3 package would
# not provide the `python` name the helper is run with, nor a pinned version.
# The RUN below fails the build when the interpreter cannot start on this base
# or still carries pip.
COPY --from=docker.io/library/python:3.14-slim@sha256:fbecd461fc72d21b2143c6eaba25143738079154a6d0ea3da3aec724f50eed4a /usr/local/bin/python3.14 /usr/local/bin/python3.14
COPY --from=docker.io/library/python:3.14-slim@sha256:fbecd461fc72d21b2143c6eaba25143738079154a6d0ea3da3aec724f50eed4a /usr/local/lib/libpython3.14.so* /usr/local/lib/
COPY --from=docker.io/library/python:3.14-slim@sha256:fbecd461fc72d21b2143c6eaba25143738079154a6d0ea3da3aec724f50eed4a /usr/local/lib/python3.14 /usr/local/lib/python3.14
RUN rm -rf /usr/local/lib/python3.14/site-packages/pip* \
        /usr/local/lib/python3.14/ensurepip \
        /usr/local/lib/python3.14/test \
        /usr/local/lib/python3.14/idlelib \
        /usr/local/lib/python3.14/tkinter \
    && ln -s python3.14 /usr/local/bin/python3 \
    && ln -s python3.14 /usr/local/bin/python \
    && ldconfig \
    && python -c "import fnmatch, hashlib, json, os, stat, tarfile; hashlib.sha256(b'')" \
    && ! python -m pip --version 2>/dev/null
# No npm, no npx: nothing in the image reaches a registry. yarn runs from the
# corepack cache (network off), and installs from the global cache only.
RUN corepack enable \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx \
    && chown -R node:node /opt/corepack /opt/yarn
ENV COREPACK_HOME=/opt/corepack \
    COREPACK_ENABLE_NETWORK=0 \
    COREPACK_ENABLE_STRICT=0 \
    YARN_ENABLE_GLOBAL_CACHE=true \
    YARN_GLOBAL_FOLDER=/opt/yarn \
    YARN_ENABLE_NETWORK=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /workspace
RUN chown node:node /workspace

USER node
