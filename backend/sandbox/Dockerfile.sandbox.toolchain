# Generic toolchain sandbox images: the build environment of a STACK, not of
# a repository. Where Dockerfile.sandbox.dev bakes this repository's own locks
# (python-dev, nodejs-dev: offline, xtm-one only), these images bake no lock
# file at all: a checkout's dependencies are installed when the checkout is
# made (uv sync, yarn or pnpm or npm install, mvn dependency:go-offline, cargo
# fetch, dbt deps), from the package registries or the registry proxy the pod
# is allowed to reach. So one image serves every repository of its stack,
# Filigran's products and any public repository alike.
#
# Five final targets, all on one base (Debian trixie, python:3.14-slim, so the
# platform's workspace helper runs everywhere as `python`), built from the
# repository root by backend/sandbox/build-dev-image.sh:
#
#   toolchain-python  Python 3.14 (default) and 3.12, pip, uv, pytest and
#                     pytest-asyncio (so a detected python-unit runs before
#                     the checkout's own install).
#   toolchain-node    Node 24 (the default `node`, /usr/local) and Node 26
#                     (/opt/node26: selected with PATH=/opt/node26/bin:$PATH),
#                     npm, corepack (yarn, pnpm).
#   toolchain-jvm     Temurin JDK 21 and Maven 3.9.
#   toolchain-rust    Rust stable (rustup), cargo, clippy, rustfmt; build
#                     output in CARGO_TARGET_DIR, outside the workspace;
#                     the GTK / WebKitGTK / D-Bus libraries a Tauri crate
#                     links (apt.sandbox.toolchain.rust.txt).
#   (toolchain-python also carries ansible-core and ansible-lint.)
#   toolchain-dbt     dbt-core and dbt-postgres in their own Python 3.12
#                     environment, `dbt` on PATH.
#
# Every target also carries Python 3.14 with pip and uv, git, a C toolchain
# (build-essential, pkg-config) and openssh-client: apt.sandbox.toolchain.runtime.txt;
# and the CI gate binaries actionlint, shellcheck, betterleaks and helm.
#
# Hardening (dev-docs/sandbox-image-hardening.md, "Toolchain images"): these
# are the named exception to rules 1 and 2 (a compiler and package managers in
# the final stage are what a build environment is for); they run only behind
# AGENTIC_CODING (Filigran-internal Copilot mode, never XTM One customers), in
# pods whose egress is an allow-list. Rule 3 holds: every FROM and every image
# COPY --from= is digest-pinned. Rule 4 holds: every target runs as
# sandboxuser (1000), and owns the toolchain directories a checkout may extend
# (a rust-toolchain.toml, a corepack-pinned yarn), so no step needs root.
#
# Usage:
#   backend/sandbox/build-dev-image.sh toolchain-<python|node|jvm|rust|dbt> sandbox-toolchain-<stack>:<version>
# then OPENSANDBOX_IMAGES="...,toolchain-python:docker.io/xtmone/sandbox-toolchain-python:<version>,..."
# (and SANDBOX_CPU / SANDBOX_RAM per key: a build needs more than 128Mi).

# ---------------------------------------------------------------------------
# stores-fetch: the offline PostgreSQL (with pgvector and the contrib
# extensions), Redis-API and S3 servers of .xtm-one/stores.py, fetched by
# their sha256 pins (a mismatch fails the build) and unpacked under
# /opt/stores with the runner beside them (/opt/stores/stores.py). Never
# shipped as such: only /opt/stores is copied out (#1858).
# ---------------------------------------------------------------------------
FROM docker.io/library/python:3.14-slim@sha256:fbecd461fc72d21b2143c6eaba25143738079154a6d0ea3da3aec724f50eed4a AS stores-fetch

COPY .xtm-one/stores.py /tmp/stores.py
RUN python /tmp/stores.py install /opt/stores

# ---------------------------------------------------------------------------
# toolchain-base: Python 3.14 (pip), uv, the runtime toolchain packages, the
# non-root user, the offline stores. Every target starts here.
# ---------------------------------------------------------------------------
FROM docker.io/library/python:3.14-slim@sha256:fbecd461fc72d21b2143c6eaba25143738079154a6d0ea3da3aec724f50eed4a AS toolchain-base

# The stores (hardening rule 2, the runtime exception python-dev already
# names): owned by root, executable by sandboxuser. A `stores = true` check
# of any repository (a CI job with a postgres service, detected or declared)
# runs through `python /opt/stores/stores.py exec -- <command>`, which starts
# PostgreSQL on loopback inside the check's own container, with no network.
COPY --from=stores-fetch /opt/stores /opt/stores

ARG TOOLCHAIN_APT_FILE=backend/sandbox/apt.sandbox.toolchain.runtime.txt

COPY ${TOOLCHAIN_APT_FILE} /tmp/toolchain-apt-packages.txt
RUN apt-get update \
    && grep -v '^\s*#' /tmp/toolchain-apt-packages.txt | grep -v '^\s*$' \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/toolchain-apt-packages.txt

COPY --from=ghcr.io/astral-sh/uv:0.11.26@sha256:3d868e555f8f1dbc324afa005066cd11e1053fc4743b9808ca8025283e65efa5 /uv /uvx /usr/local/bin/
# actionlint (a static Go binary) for the detected actions-lint check: the
# workflows of any checkout are linted offline, whatever its stack.
COPY --from=docker.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 /usr/local/bin/actionlint /usr/local/bin/actionlint
RUN actionlint -version

# The CI gates of a pull request that are single static binaries, so a check
# runs them in the sandbox before the push (#11710, dev-docs/reference/
# sandbox-workspace.md "CI parity"): betterleaks (the secret scan a CI job runs
# from its image) and helm (helm template / lint of a chart). Each archive is
# fetched from its release, its SHA-256 pinned per architecture (a mismatch
# fails the build), and only the binary is kept. ShellCheck comes from Debian
# (apt.sandbox.toolchain.runtime.txt), and actionlint calls it when present.
ARG TARGETARCH
ARG BETTERLEAKS_VERSION=1.9.0
ARG BETTERLEAKS_SHA256_AMD64=f8b185a39ffcece2a1ca82bf3a4e7435cd81963ffd16b7a9128daf75f35f6de7
ARG BETTERLEAKS_SHA256_ARM64=1d39116e0a58dc94574715e2aa12a2dbd5062f193eee3fec011fef6ba06bd13b
ARG HELM_VERSION=4.3.2
ARG HELM_SHA256_AMD64=d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983
ARG HELM_SHA256_ARM64=df31cb61680ef728f82c770e5280dd565617bee6b039d37e85c677288be4bbb0
RUN set -eu; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in \
      amd64) bl_arch=x64; bl_sum="$BETTERLEAKS_SHA256_AMD64"; helm_sum="$HELM_SHA256_AMD64" ;; \
      arm64) bl_arch=arm64; bl_sum="$BETTERLEAKS_SHA256_ARM64"; helm_sum="$HELM_SHA256_ARM64" ;; \
      *) echo "no pinned CI tools for $arch" >&2; exit 1 ;; \
    esac; \
    fetch() { python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$1" "$2"; echo "$3  $2" | sha256sum -c -; }; \
    mkdir -p /tmp/ci-tools/bl /tmp/ci-tools/helm; \
    fetch "https://github.com/betterleaks/betterleaks/releases/download/v${BETTERLEAKS_VERSION}/betterleaks_${BETTERLEAKS_VERSION}_linux_${bl_arch}.tar.gz" /tmp/ci-tools/bl.tgz "$bl_sum"; \
    fetch "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${arch}.tar.gz" /tmp/ci-tools/helm.tgz "$helm_sum"; \
    tar -xzf /tmp/ci-tools/bl.tgz -C /tmp/ci-tools/bl; \
    tar -xzf /tmp/ci-tools/helm.tgz -C /tmp/ci-tools/helm; \
    install -m 0755 "$(find /tmp/ci-tools/bl -type f -name betterleaks | head -n 1)" /usr/local/bin/betterleaks; \
    install -m 0755 "$(find /tmp/ci-tools/helm -type f -name helm | head -n 1)" /usr/local/bin/helm; \
    rm -rf /tmp/ci-tools; \
    betterleaks version; helm version --short; shellcheck --version

RUN groupadd -g 1000 sandboxuser && useradd -u 1000 -g sandboxuser -m sandboxuser \
    && mkdir -p /workspace && chown sandboxuser:sandboxuser /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy

WORKDIR /workspace

# ---------------------------------------------------------------------------
# toolchain-python: + CPython 3.12 beside 3.14, copied from the digest-pinned
# python:3.12-slim (same Debian release, so the same glibc and OpenSSL).
# `uv python find 3.12` and `python3.12 -m venv` both find it. pytest and
# pytest-asyncio (the versions of backend/uv.lock) in the default 3.14, so a
# detected `python -m pytest` runs on a checkout with no lock and no install
# yet; a checkout's own install may pin another version over them.
# ---------------------------------------------------------------------------
FROM toolchain-base AS toolchain-python

COPY --from=docker.io/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 /usr/local/bin/python3.12 /usr/local/bin/python3.12
COPY --from=docker.io/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/
COPY --from=docker.io/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=docker.io/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 /usr/local/include/python3.12 /usr/local/include/python3.12
RUN ldconfig \
    && python3.12 -c "import ssl, sqlite3, ctypes, venv" \
    && python3.14 -c "import ssl, sqlite3, ctypes, venv" \
    && uv --version && pip --version

ARG PYTEST_VERSION=9.0.3
ARG PYTEST_ASYNCIO_VERSION=1.3.0
# PyYAML (the version of backend/uv.lock): the actions-lint check parses workflows and actions with it.
ARG PYYAML_VERSION=6.0.3
RUN pip install --no-cache-dir "pytest==${PYTEST_VERSION}" "pytest-asyncio==${PYTEST_ASYNCIO_VERSION}" "PyYAML==${PYYAML_VERSION}" \
    && python -m pytest --version && python -c "import yaml"

# ansible-core and ansible-lint in their own environment (/opt/ansible, Python
# 3.14), linked on PATH, so an Ansible repository's lint and render gates run
# before its own install (FiligranHQ/platform ansible-lint.yml pins
# ansible-core >=2.19,<2.22 and ansible-lint >=25.8). A checkout's Galaxy
# collections are installed with `ansible-galaxy install -r requirements.yml`.
ARG ANSIBLE_CORE_VERSION=2.21.6
ARG ANSIBLE_LINT_VERSION=26.11.0
RUN uv venv --python /usr/local/bin/python3.14 /opt/ansible \
    && uv pip install --no-cache --python /opt/ansible/bin/python \
        "ansible-core==${ANSIBLE_CORE_VERSION}" "ansible-lint==${ANSIBLE_LINT_VERSION}" \
    && for b in ansible ansible-playbook ansible-galaxy ansible-lint; do ln -s /opt/ansible/bin/$b /usr/local/bin/$b; done \
    && ansible --version && ansible-lint --version

# Poetry in its own environment (/opt/poetry, Python 3.14), linked on PATH, so
# the checks detected on a Poetry project (`poetry install`, `poetry run
# pytest|ruff|mypy|flake8`) run as its CI runs them (OpenAEV-Platform/collectors
# CI pins poetry==2.3.2). Its virtualenvs go to the user cache, never into the
# checkout. poetry-plugin-pypi-mirror (BSD-3-Clause) sends every pypi.org
# request to POETRY_PYPI_MIRROR_URL when the pool sets a registry mirror
# (registry_mirror.command_env), with no change to the checkout or its lock:
# Poetry reads neither PIP_INDEX_URL nor UV_DEFAULT_INDEX.
ARG POETRY_VERSION=2.3.2
ARG POETRY_PLUGIN_PYPI_MIRROR_VERSION=0.6.5
RUN uv venv --python /usr/local/bin/python3.14 /opt/poetry \
    && uv pip install --no-cache --python /opt/poetry/bin/python "poetry==${POETRY_VERSION}" \
        "poetry-plugin-pypi-mirror==${POETRY_PLUGIN_PYPI_MIRROR_VERSION}" \
    && ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry \
    && poetry --version \
    && uv pip show --python /opt/poetry/bin/python poetry-plugin-pypi-mirror

USER sandboxuser

# ---------------------------------------------------------------------------
# toolchain-node: Node 24 in /usr/local (the default `node`), Node 26 in
# /opt/node26, both from digest-pinned official images (Debian trixie, the
# same glibc as the base). corepack is installed from npm at a pinned version
# for both (Node 25 and later no longer bundle it) and enabled, so `yarn` and
# `pnpm` resolve to the release a checkout's packageManager field names.
# ---------------------------------------------------------------------------
FROM toolchain-base AS toolchain-node

COPY --from=docker.io/library/node:24-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446 /usr/local/bin/node /usr/local/bin/node
COPY --from=docker.io/library/node:24-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446 /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=docker.io/library/node:24-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446 /usr/local/include/node /usr/local/include/node
COPY --from=docker.io/library/node:26-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 /usr/local/bin/node /opt/node26/bin/node
COPY --from=docker.io/library/node:26-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 /usr/local/lib/node_modules/npm /opt/node26/lib/node_modules/npm
COPY --from=docker.io/library/node:26-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 /usr/local/include/node /opt/node26/include/node

ARG COREPACK_VERSION=0.36.0
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /opt/node26/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /opt/node26/bin/npx \
    && node --version && npm --version \
    && npm install -g --no-fund --no-audit "corepack@${COREPACK_VERSION}" \
    && corepack enable \
    && PATH=/opt/node26/bin:$PATH sh -c ' \
        node --version && npm --version \
        && npm install -g --prefix /opt/node26 --no-fund --no-audit "corepack@${COREPACK_VERSION}" \
        && corepack enable --install-directory /opt/node26/bin' \
    && npm cache clean --force \
    && mkdir -p /home/sandboxuser/.cache/node/corepack \
    && chown -R sandboxuser:sandboxuser /home/sandboxuser/.cache /usr/local/lib/node_modules /opt/node26

# node-gyp builds a native addon against the headers of the running Node and
# downloads them from nodejs.org unless told where they are: the pods' egress
# does not reach nodejs.org, so a yarn or npm install with one native addon
# failed. The headers of each bundled Node are in the image already (with
# common.gypi and config.gypi): npm_config_nodedir points node-gyp at the
# default Node 24's. A command on Node 26 sets npm_config_nodedir=/opt/node26
# with its PATH.
ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    npm_config_nodedir=/usr/local

USER sandboxuser

# ---------------------------------------------------------------------------
# toolchain-jvm: Temurin JDK 21 and Maven 3.9, copied from their digest-pinned
# official images (both self-contained trees). A Gradle checkout runs its own
# wrapper (gradlew) on this JDK.
# ---------------------------------------------------------------------------
FROM toolchain-base AS toolchain-jvm

COPY --from=docker.io/library/eclipse-temurin:21-jdk@sha256:ebfbb18d11ff163ee83b21258acf12248af48d22a0fdfdc68fa1a1516c05976a /opt/java/openjdk /opt/java/openjdk
COPY --from=docker.io/library/maven:3.9-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 /usr/share/maven /usr/share/maven
ENV JAVA_HOME=/opt/java/openjdk \
    MAVEN_HOME=/usr/share/maven \
    PATH="/opt/java/openjdk/bin:/usr/share/maven/bin:$PATH"
RUN java -version && javac -version && mvn --version \
    && mkdir -p /home/sandboxuser/.m2 && chown -R sandboxuser:sandboxuser /home/sandboxuser/.m2

USER sandboxuser

# ---------------------------------------------------------------------------
# toolchain-rust: rustup's stable toolchain from the digest-pinned official
# image, with clippy and rustfmt. RUSTUP_HOME and CARGO_HOME belong to
# sandboxuser, so a checkout's rust-toolchain.toml installs its own release.
# CARGO_TARGET_DIR sits outside /workspace: a build never writes target/ into
# the checkout (the workspace would save it back, count it against the quota
# and a commit from the checkout would carry it), and the container keeps it
# between commands, so a second cargo command builds incrementally.
# ---------------------------------------------------------------------------
FROM toolchain-base AS toolchain-rust

# The development libraries a Tauri desktop crate links (GTK, WebKitGTK, D-Bus,
# xcb), the list runner-ci.yml installs with apt before clippy and the tests:
# without them `cargo clippy` stops at the first -sys build script.
COPY backend/sandbox/apt.sandbox.toolchain.rust.txt /tmp/toolchain-rust-apt-packages.txt
RUN apt-get update \
    && grep -v '^\s*#' /tmp/toolchain-rust-apt-packages.txt | grep -v '^\s*$' \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/toolchain-rust-apt-packages.txt \
    && pkg-config --exists gtk+-3.0 webkit2gtk-4.1 dbus-1

COPY --from=docker.io/library/rust:1-slim-trixie@sha256:b8e062b1c3a80183df83d9ba187cadd2b5ab84bc78d453dbfeb2fccd5f982247 /usr/local/rustup /usr/local/rustup
COPY --from=docker.io/library/rust:1-slim-trixie@sha256:b8e062b1c3a80183df83d9ba187cadd2b5ab84bc78d453dbfeb2fccd5f982247 /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    CARGO_TARGET_DIR=/home/sandboxuser/.cache/cargo-target \
    PATH="/usr/local/cargo/bin:$PATH"
RUN rustup component add clippy rustfmt \
    && rustc --version && cargo --version && cargo clippy --version && cargo fmt --version \
    && mkdir -p /home/sandboxuser/.cache/cargo-target \
    && chown -R sandboxuser:sandboxuser /usr/local/rustup /usr/local/cargo /home/sandboxuser/.cache

USER sandboxuser

# ---------------------------------------------------------------------------
# toolchain-dbt: dbt-core and the Postgres adapter in /opt/dbt, a Python 3.12
# environment (the version dbt supports), `dbt` linked on PATH; the default
# `python` stays 3.14. A checkout's packages.yml is installed with `dbt deps`.
# ---------------------------------------------------------------------------
FROM toolchain-base AS toolchain-dbt

COPY --from=docker.io/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 /usr/local/bin/python3.12 /usr/local/bin/python3.12
COPY --from=docker.io/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/
COPY --from=docker.io/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 /usr/local/lib/python3.12 /usr/local/lib/python3.12
ARG DBT_CORE_VERSION=1.11.12
ARG DBT_POSTGRES_VERSION=1.10.2
RUN ldconfig \
    && uv venv --python /usr/local/bin/python3.12 /opt/dbt \
    && uv pip install --no-cache --python /opt/dbt/bin/python \
        "dbt-core==${DBT_CORE_VERSION}" "dbt-postgres==${DBT_POSTGRES_VERSION}" \
    && ln -s /opt/dbt/bin/dbt /usr/local/bin/dbt \
    && dbt --version

USER sandboxuser
