# Visual-regression captures written by frontend/scripts/gallery-shots.mjs.
# Reference images for reviewing a styling change, regenerated on demand.
.visual/

# spec-kit (speckit)
# `.specify/` (constitution, templates, scripts, workflows) and `specs/` (feature
# specs, plans, tasks) are tracked so the spec-driven artifacts are shared.
# Machine-local Spec Kit state is excluded by `.specify/.gitignore`.
.specify/input/
.specify/qa/
.specify/integrations/.cache/
# Per-developer agent files. The manifests in `.specify/integrations/` declare
# which agents this repo supports; each developer materializes their own with
# `specify integration upgrade <agent>`. Agent folders can also accumulate
# credentials, which is why Spec Kit itself recommends excluding them.
.github/agents/speckit.*
.github/prompts/speckit.*
.github/skills/speckit-*
.claude/skills/speckit-*
# Per-developer dev-server preview config.
.claude/launch.json
