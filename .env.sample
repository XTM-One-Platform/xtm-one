# =============================================================================
# XTM One – Environment Variables
# =============================================================================
#
# QUICK START
# -----------
# 1. Copy this file:  cp .env.sample .env
# 2. Fill in the values below (especially ADMIN_EMAIL / ADMIN_PASSWORD).
# 3. Run:              docker compose up -d
# 4. Open:             http://localhost:4000  (production)
#    or                http://localhost:3100  (dev mode – docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build)
# 5. Log in with the admin credentials defined below.
# 6. Go to Settings to configure SSO, integrations, and LLM providers.
#
# NOTE: This file contains ONLY infrastructure settings.
# All authentication (SSO, OIDC, SAML, registration, domains) and
# integration credentials are configured via the Settings UI.
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. INFRASTRUCTURE  (used by docker-compose & backend)
# -----------------------------------------------------------------------------

# PostgreSQL password – the compose file creates user "copilot" with this pw.
DB_PASSWORD=copilot_dev

# Connection strings – uncomment these ONLY for a backend running outside
# Docker against docker-compose.dev.yml, which exposes PostgreSQL on host port
# 5432, Redis on 6380 and Silo on 9002 (moved by the DEV_*_PORT settings
# below). docker-compose.yml builds its own
# connection strings from DB_PASSWORD — leaving these ACTIVE would inject
# unreachable localhost endpoints into its containers and break the quick
# start. The dev override (docker-compose.dev.yml) always uses its own
# services.
# DATABASE_URL=postgresql+asyncpg://copilot:copilot_dev@localhost:5432/copilot
# REDIS_URL=redis://localhost:6380

# Host ports of docker-compose.dev.yml. Give a second checkout (a git worktree)
# its own set to run both stacks at once. BASE_URL and FRONTEND_URL follow
# DEV_PLATFORM_PORT and DEV_FRONTEND_PORT.
# DEV_FRONTEND_PORT=3100
# DEV_PLATFORM_PORT=8100
# DEV_POSTGRES_PORT=5432
# DEV_REDIS_PORT=6380
# DEV_SILO_PORT=9002
# DEV_SILO_CONSOLE_PORT=9003
# DEV_REDISINSIGHT_PORT=5540

# Redis password – optional. If set, Redis will require authentication.
# The REDIS_URL must also include the password: redis://:yourpassword@host:6379
# For TLS connections, use rediss:// scheme: rediss://:yourpassword@host:6379
# The dev stack (docker-compose.dev.yml) ignores both: its Redis runs with no
# password and the platform and the workers use its own REDIS_URL.
# REDIS_PASSWORD=
# REDIS_URL=redis://:yourpassword@localhost:6379

# Redis HA mode – "standalone" (default) or "sentinel".
# Redis Cluster is intentionally not supported — the SAQ worker uses
# BLMOVE + multi-key Lua scripts that are not cluster-safe.
# REDIS_MODE=standalone
#
# --- Sentinel mode ---
# Comma-separated host:port list of Sentinel nodes (default port 26379).
# REDIS_SENTINEL_HOSTS=sentinel-a:26379,sentinel-b:26379,sentinel-c:26379
# REDIS_SENTINEL_SERVICE=mymaster
# REDIS_SENTINEL_PASSWORD=
#
# --- Data-plane auth (applies to all modes) ---
# REDIS_USERNAME=
# REDIS_DB=0
#
# --- Shared Redis ---
# Prefix of every key, job queue and pub/sub channel, e.g. xtm-one-prod:
# A Redis user limited to ~<prefix>* &<prefix>* is then enough.
# REDIS_KEY_PREFIX=
#
# --- TLS for sentinel mode (standalone uses rediss:// in REDIS_URL) ---
# REDIS_SSL=false
# REDIS_SSL_CA_CERTS=/etc/ssl/certs/redis-ca.pem
# REDIS_SSL_CERT_REQS=required

# -----------------------------------------------------------------------------
# 1b. FILE STORAGE  (S3 / Silo – stores chat file attachments, workflow outputs)
# -----------------------------------------------------------------------------

# S3-compatible endpoint. Docker Compose uses the built-in Silo service (S3-compatible MinIO fork) —
# leave S3_ENDPOINT commented for the Docker quick start (the compose default
# is minio:9000). Uncomment ONLY for a backend running outside Docker
# (docker-compose.dev.yml exposes Silo on host port 9002).
# For AWS S3, set to "s3.amazonaws.com" and enable SSL.
# S3_ENDPOINT=localhost:9002
S3_ACCESS_KEY=copilot
S3_SECRET_KEY=copilot_dev_secret
S3_BUCKET=copilot-files
S3_USE_SSL=false
# S3_REGION=us-east-1  # Required for AWS S3, ignored by Silo
# AWS S3 without static keys: take credentials from the pod or instance role
# (EKS IRSA / Pod Identity, ECS task role, EC2 instance profile). The keys above
# are then ignored. Presigned URLs then expire with the role session at the latest.
# S3_USE_AWS_ROLE=false
# Per-operation timeouts (seconds) for the S3/MinIO HTTP client. The MinIO SDK
# is synchronous and runs on the shared default thread pool; without a timeout a
# slow/blackholed object store pins those threads forever and starves DB
# connection establishment. READ is a between-bytes timeout, so
# steady large transfers are unaffected.
# S3_CONNECT_TIMEOUT=10
# S3_READ_TIMEOUT=60

# -----------------------------------------------------------------------------
# 1c. PLATFORM MODE
# -----------------------------------------------------------------------------

# "xtm_one" = XTM One (default, open, EE features unlocked by registered platform licenses)
# "copilot" = Agentic platform (specific Filigran license required)
# "dev" = Agentic platform with XTM One seeding (specific Filigran license required)
# "ai_disabled" = platform shell only: nothing seeded, no AI schedulers, no LLM
#   or embedding traffic. Deterministic flows and all non-AI administration keep
#   working. This is the deployment default: an administrator can override it
#   at runtime from Settings -> Parameters without a restart.
#
# Product identity (name, logo, favicon, theme colors, OG image, description)
# is managed from Settings → Parameters and stored in the `platform_settings`
# row. PLATFORM_MODE controls licensing behavior, default seeding, and the CSS
# skin; when the DB name is empty, runtime branding falls back to the
# mode-specific product name.
PLATFORM_MODE=xtm_one

# Shared secret OpenCTI/OpenAEV/OpenCRQ present (Authorization: Bearer) to
# register themselves with XTM One. All services must use the same value.
# Use a strong secret: the registration answer can carry the Filigran license.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = platform registration disabled (every registration is refused) -
# except under Docker Compose, which then falls back to a PUBLISHED default
# kept so the platforms of existing deployments stay connected: it cannot
# register a new platform or change a registered platform's URL, XTM One
# logs a warning at startup and the security audit (Settings > Security)
# reports it as critical.
PLATFORM_REGISTRATION_TOKEN=

# Optional Docker-internal API URL overrides for registered platforms.
# When set, XTM One calls the platform API, fetches the platform's signing
# keys and sends its callbacks on this URL instead of the public
# platform_url from the registration. The public URL stays the platform's
# identity: the issuer XTM One trusts and the audience of the tokens it
# sends there. Caveat: integration deep links ("[Open in ...]") are
# currently built from the same URL for all platforms, so they point at the
# internal host while the override is active - prefer making the public URL
# reachable from XTM One when users rely on deep links.
# OPENCTI_API_URL=
# OPENAEV_API_URL=
# OPENCRQ_API_URL=
# (The pre-rename name OPENGRC_API_URL is still read, with a deprecation
# warning, until 2026-12-31 - rename it to OPENCRQ_API_URL.)

# Optional: the URLs the platforms are configured to reach XTM One on, when
# they differ from BASE_URL (e.g. http://xtm-one:4000 in Docker Compose).
# Comma-separated. Accepted as the audience of the platforms' tokens, for
# platform versions that address their tokens to that URL instead of the
# identity XTM One publishes at /xtm/auth/metadata. An entry that is not an
# http(s) URL, or that carries credentials, a query or a fragment, fails
# startup.
# XTM_AUTH_ACCEPTED_AUDIENCES=

# Enterprise license PEM (Copilot mode only). Paste the full PEM certificate
# here, or configure it via the Settings UI after first login.
# Takes precedence over the database setting when set.
# ENTERPRISE_LICENSE=

# Optional forced platform instance ID (UUID). The `platform_settings` row ID
# doubles as the anonymous telemetry instance_id; forcing it keeps the platform
# identity stable across clones / database restores / re-installs (mirrors
# OpenCTI's PLATFORM_ID and OpenAEV's OPENAEV_INSTANCEID). On a fresh install
# the singleton is created with this UUID; on an existing install the row is
# re-keyed to it at startup. Must be a valid UUID; leave unset to auto-generate.
# PLATFORM_ID=

# The XTM Hub this platform registers with by default (Settings > Parameters,
# automatic registration of a trial), the one the product switcher links to and
# the XTM Hub integration's address when it names none. See
# docs/docs/deployment/configuration.md.
# XTM_HUB_DEFAULT_URL=https://hub.filigran.io

# --- XTM Hub sign-in entitlement gate ---
# When this instance is federated through XTM Hub, the Hub decides which XTM One
# instances each person may reach. Setting XTM_HUB_ADMIN_GROUP ENABLES the gate:
# sign-in then requires a `{PLATFORM_ID}_groups` claim naming this instance, and
# the value below is the role within it that means administrator (matched
# exactly, including case). Leave unset and OIDC behaves as it always has.
# Enabling it without PLATFORM_ID refuses to start. See
# docs/docs/deployment/configuration.md.
# XTM_HUB_ADMIN_GROUP=Admin

# Optional comma-separated deployment tags (e.g. "saas,eu-west") attached to
# the anonymous usage telemetry so adoption analytics can slice metrics by
# deployment dimension. Tags are normalized before export (trimmed,
# lowercased, deduped, sorted). Not exposed in the UI or any API.
# TELEMETRY_TAGS=

# Optional branding overrides (product name + logo). Precedence:
#   1. DB `platform_settings` (configured via Settings → Parameters) — wins
#   2. These env vars — used when the DB value is empty
#   3. Mode default (e.g. "XTM One" / "Filigran Copilot")
# Only `name` and `logo` are env-configurable; description, theme colors,
# favicon, and OG image remain DB-only. PLATFORM_LOGO must be a base64
# data URL, e.g. `data:image/svg+xml;base64,PHN2Zy...`.
# PLATFORM_NAME=
# PLATFORM_LOGO=

# -----------------------------------------------------------------------------
# 1d. XTM ONE BUILT-IN INTEGRATIONS  (XTM One / dev mode only)
# -----------------------------------------------------------------------------
#
# NOTE: integration credentials normally live in the Settings UI / database.
# The env vars below are a limited exception used to seed company-managed
# integrations on first XTM One startup (or in `dev` mode).
#
# - Google Search: the key is rewritten from these variables on every
#   startup, so a change made in the UI is replaced at the next restart.
# - Filigran AI: URLs are refreshed on every startup so env var changes
#   take effect immediately on restart.
#
# Whitespace-only values are rejected at startup; the affected integration
# is skipped and a warning is logged naming the env var.
#
# Built-in web search: ONE provider is seeded. Brave Search when
# BUILTIN_BRAVE_SEARCH_API_KEY is set; else Google Search when
# BUILTIN_GOOGLE_SEARCH_API_KEY is set; neither = no built-in web search.
# Brave's tools also answer to the Google tool names (search_google_web,
# search_google_images), so personas naming them keep working.
#
# Brave Search API — subscription token (X-Subscription-Token header).
# Create it in the Brave Search API dashboard: api-dashboard.search.brave.com
# BUILTIN_BRAVE_SEARCH_API_KEY=<BSA...>
#
# Google Custom Search (closed to new customers, stops 1 Jan 2027) —
# compound token: "search_engine_id||api_key"
# Obtain an API key at: console.cloud.google.com/apis/credentials
# Create a Programmable Search Engine at: programmablesearchengine.google.com
# BUILTIN_GOOGLE_SEARCH_API_KEY=<cx>||<AIza...>

# Filigran AI — fine-tuned models for STIX/TTP extraction (always seeded).
# These env vars override the hardcoded default URLs. Leave empty to use defaults.
# Updated on every startup (unlike other integrations, changes take effect on restart).
# FILIGRAN_AI_BASE_URL_STIX=https://importdoc.ariane.filigran.io
# FILIGRAN_AI_BASE_URL_TTP=https://ttpextraction.ariane.filigran.io

# -----------------------------------------------------------------------------
# 1e. SECURITY FEATURE FLAGS  (optional – disable potentially dangerous features)
# -----------------------------------------------------------------------------
#
# These flags disable specific platform features at the infrastructure level.
# They are read from environment variables at startup and cannot be changed
# by any user (including admins) without restarting the server.
#
# Set to "true" to disable a feature platform-wide.
# Default: all features are enabled in copilot mode, disabled in xtm_one mode.
#
# Block Javascript / Python code execution via the AI
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# DISABLE_CODE_INTERPRETER=true
# Block custom JS/Python tool creation & use
# DISABLE_CUSTOM_TOOLS=true
# Block custom variable creation & use
# DISABLE_CUSTOM_VARIABLES=true
#
# Trusts X-Forwarded-For / X-Forwarded-Proto from ANY peer and takes the client
# from the leftmost X-Forwarded-For value, which the client writes itself behind
# a proxy that appends to the header. ONLY enable behind a proxy that overwrites
# the header and is the only thing that reaches the platform; FORWARDED_ALLOW_IPS
# below is the safer setting (see UPGRADING.md). It wins over FORWARDED_ALLOW_IPS
# when both are set; while on, the platform warns at startup and the security
# audit reports it.
# The shipped docker-compose.yml does not pass this variable to the platform
# container.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# TRUST_PROXY_HEADERS=false
#
# Which proxy addresses may set the forwarding headers: an IP, a CIDR, or a
# comma-separated list, naming the proxy as the platform container sees it.
# The claim is honoured only from the named peer, and the client is read from
# the end of the X-Forwarded-For chain rather than its caller-controlled start.
# Hostnames are not resolved and a CIDR needs its host bits at zero: such an
# entry trusts nobody (named in a startup warning). "*" trusts any peer and
# reads the start of the chain again - only as the whole value.
# Empty leaves uvicorn's own default, 127.0.0.1.
# Until it names your reverse proxy, the audit log and per-IP rate limiting
# record the proxy's address for every user. Set it to the address the platform
# container sees the proxy connect from: the platform logs a warning naming that
# peer ("A request carried X-Forwarded-For ...") once per process, and the
# security audit (Settings > Security) reports it. A proxy on the Docker host
# connects from the Compose network's gateway, not from 127.0.0.1. Read by
# uvicorn at startup: not a Settings > Security field, restart after a change.
# See docs/docs/deployment/installation.md, "Client address and protocol behind the proxy".
# FORWARDED_ALLOW_IPS=
#
# Runner enrollment, MCP OAuth client registration and the MCP OAuth token
# endpoint serve a request whose transport the platform cannot confirm
# encrypted, and log it once per route. true (opt-in) refuses it instead:
# 403 "https required" on enrollment, the OAuth
# invalid_client_metadata error on registration, the OAuth invalid_request
# error on the token endpoint. Behind a TLS-terminating proxy, set
# FORWARDED_ALLOW_IPS first.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# CREDENTIAL_TRANSPORT_STRICT=false
#
# Client addresses (the X-Forwarded-For hop under TRUST_PROXY_HEADERS, the
# peer otherwise) are keyed, logged and stored as they were read, as before.
# true (opt-in) uses their canonical form instead - port, brackets and IPv6
# zone dropped, IPv4-mapped read as IPv4, IPv6 lowercase - so one client is one
# rate-limit key whatever the proxy wrote (IP:port included). A value that is
# not an IP address is ignored either way, with a warning logged once.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# CLIENT_IP_STRICT=false
#
# Prefix length the per-IP rate limits (login, password reset, invitation
# registration, MFA, A2A pre-authentication, MCP OAuth, the public chat widget,
# Content Security Policy violation reports) key a native IPv6 client on.
# 128 (default) keeps one bucket per address. 64 is opt-in: it stops a client
# drawing a fresh bucket from every address of the /64 it is handed, but every
# device of one /64 (a corporate IPv6 LAN) then shares one budget. 32 to 128;
# IPv4 is always keyed per address. The key in use is logged at startup, and
# the security audit recommends 64 while it is above 64.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# RATE_LIMIT_IPV6_PREFIX=128

# END-TO-END TESTS ONLY - never set on a deployment. Peer IPs / CIDRs whose
# plain http requests count as encrypted on the A2A surface, for a suite that
# reaches a containerised platform from the Docker bridge gateway. Only the
# real socket peer counts (a request carrying X-Forwarded-For is never exempt).
# Startup is refused outside the end-to-end stack (without its loopback
# exemption, A2A_ALLOW_INSECURE_LOOPBACK=true) and for a network that is not
# private. Behind a TLS-terminating proxy, set FORWARDED_ALLOW_IPS instead.
# TEST_ONLY_INSECURE_TRANSPORT_PEERS=
#
# TESTING ONLY. Count a plain http request from real loopback (127.0.0.1, ::1)
# as encrypted, so a deployment federated with itself reaches its own A2A
# card without TLS. A request carrying X-Forwarded-For is never exempt; never
# set it behind a reverse proxy on the same host. TEST_ONLY_INSECURE_TRANSPORT_PEERS
# needs this variable itself (the Settings > Security field does not count).
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# A2A_ALLOW_INSECURE_LOOPBACK=false
#
# LOCAL DEVELOPMENT ONLY. Origins (scheme://host[:port], comma-separated) that
# outbound A2A requests may reach over plain http and at addresses the
# destination guard otherwise refuses (a second deployment on this machine).
# Cloud metadata addresses stay refused; a malformed entry stops the platform.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# A2A_CLIENT_DEV_TRUSTED_ORIGINS=
#
# OAuth token requests (code exchange and refresh, for integrations and MCP
# servers) refuse a token URL on a cloud-metadata address, checked when it is
# saved and before each request; every other token URL that worked before
# keeps working. Opt-in strict mode also refuses token URLs on
# loopback, link-local, unspecified, reserved and multicast addresses and any
# scheme but http(s); private networks stay allowed.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# OAUTH_TOKEN_URL_STRICT=false
#
# With strict mode on, for LOCAL DEVELOPMENT only, list the origins
# (scheme://host[:port], comma-separated) whose token URL may be on a
# loopback address. Link-local and metadata addresses stay refused. No effect
# while strict mode is off.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# OAUTH_TOKEN_DEV_TRUSTED_ORIGINS=
#
# Which addresses a remote MCP server (sse / streamable_http) may be reached
# at, checked when its URL is saved and on the address every connection opens
# to (redirects and OAuth discovery included):
#   permissive        (default) refuse only cloud metadata addresses
#   private_networks  also refuse loopback, link-local and reserved addresses
#   public_only       refuse every internal address (use a relay group)
# Behind HTTP_PROXY / HTTPS_PROXY, permissive keeps using the proxy; the two
# stricter modes connect directly. Blank = unset (Settings > Security decides).
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# MCP_SERVER_URL_POLICY=permissive
#
# Under private_networks / public_only, origins (scheme://host[:port],
# comma-separated) an MCP server may be reached at whatever their address.
# Cloud metadata addresses stay refused; a malformed entry stops the platform.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# MCP_SERVER_TRUSTED_ORIGINS=
#
# Custom tool sandbox isolation: auto (default) | docker | subprocess | opensandbox
#   auto        = prefer the hardened Docker sandbox when Docker is available,
#                 fall back to a plain subprocess with a one-time warning
#   docker      = require Docker; tool execution fails when Docker is missing
#   subprocess  = always run in a plain subprocess - no hardened Docker container
#                 isolation (JS runs under the Node.js permission model when
#                supported, see below; Python runs in isolated mode with a
#                 best-effort module-blocklist sandbox)
#   opensandbox = delegate to an OpenSandbox-managed container via the
#                 opensandbox SDK; also used by the code interpreter
#                 (requires OPENSANDBOX_DOMAIN / PROTOCOL / API_KEY below)
# The legacy CUSTOM_TOOL_DOCKER=true env var is deprecated; it is treated as
# docker only when CUSTOM_TOOL_SANDBOX is not set (an explicit value wins).
CUSTOM_TOOL_SANDBOX=opensandbox
#
# Node.js permission model for the subprocess fallback (default: true).
# When custom tools run in a plain subprocess (no Docker), JavaScript tools
# are executed under `node --permission` when the installed Node supports it
# (stable since Node 24): file system access, child processes, worker threads
# and native addons are denied; network stays available. Set to false only if
# legacy custom tools genuinely need direct file-system or child-process
# access in the subprocess fallback.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# CUSTOM_TOOL_NODE_PERMISSION=true
#
# OpenSandbox connection (required when CUSTOM_TOOL_SANDBOX=opensandbox).
# OPENSANDBOX_DOMAIN usually stays unset: docker-compose.yml and the dev
# override (docker-compose.dev.yml) point it at the "opensandbox" service,
# and a value here overrides that. Set it only for an OpenSandbox server
# elsewhere. docker-compose.yml forwards CUSTOM_TOOL_SANDBOX and these
# OPENSANDBOX_* variables to the platform and the workers.
# OPENSANDBOX_DOMAIN=localhost:8090
# OPENSANDBOX_PROTOCOL=http
# The "opensandbox" service's API key, also the one the platform sends. The
# server refuses to start without one; the dev override defaults it.
OPENSANDBOX_API_KEY=change-me-in-production
# Route sandbox traffic through the OpenSandbox server instead of connecting
# directly to each sandbox's endpoint - useful for any deployment topology
# where this process can reach the OpenSandbox server but not the individual
# sandbox endpoints it hands back (e.g. a production/k8s deployment where
# sandbox pods aren't directly routable from this process - see
# Settings.opensandbox_use_server_proxy).
# OPENSANDBOX_USE_SERVER_PROXY=false
# Per-key container image overrides, comma-separated "key:image" pairs.
# Overrides merge on top of the built-in defaults (sandbox-python:0.4,
# sandbox-nodejs:0.4), so overriding just one key leaves the other on its
# default.
# OPENSANDBOX_IMAGES=python:sandbox-python:0.4,nodejs:sandbox-nodejs:0.4
# sandbox_run_command runs a checkout's declared checks (.xtm-one/checks.toml)
# on the image key each check names: add the dev images built by
# backend/sandbox/build-dev-image.sh, e.g.
# OPENSANDBOX_IMAGES=python:sandbox-python:0.4,nodejs:sandbox-nodejs:0.4,python-dev:sandbox-python-dev:0.1,nodejs-dev:sandbox-nodejs-dev:0.1
# k8s only - do NOT uncomment for local Docker Compose dev. Binds sandbox
# creation to a pre-warmed k8s Pool (comma-separated key:pool-name pairs);
# the local docker-compose opensandbox-server has no Pool CRD to bind to,
# so setting this here would make every sandbox creation fail.
# OPENSANDBOX_K8S_POOL_NAMES=python:my-python-pool,nodejs:my-js-pool
# k8s-only: the namespace the OpenSandbox server runs its sandboxes and Pool
# pods in. Set, the worker deletes there the Pool pods that ended or are
# stuck (a Pool never replaces them) and the expired BatchSandboxes; the
# service account needs pods and batchsandboxes get/list/delete in it.
# OPENSANDBOX_K8S_NAMESPACE=opensandbox
# Seconds a Pool pod may stay not Running and ready before the reaper deletes it.
# OPENSANDBOX_POOL_STUCK_SECONDS=600
# Container engine API socket the opensandbox Compose service manages
# sandboxes through. Rootless Podman: $XDG_RUNTIME_DIR/podman/podman.sock
# (e.g. /run/user/1000/podman/podman.sock, with podman.socket enabled).
# CONTAINER_ENGINE_SOCKET=/var/run/docker.sock
#
# docker-compose.yml starts the OpenSandbox server (the "opensandbox" service)
# only with the "opensandbox" profile (COMPOSE_PROFILES=opensandbox, with
# OPENSANDBOX_API_KEY set); the dev override always starts it. It runs
# sandboxes as containers on this host and answers at opensandbox:8090
# (OPENSANDBOX_DOMAIN=opensandbox:8090). For sandboxes as pods
# on a Kubernetes cluster, point OPENSANDBOX_DOMAIN at an opensandbox-server
# deployed there instead - see dev-docs/opensandbox-pool-management.md.
# Comma-separated list of domains/IPs to allow as egress from every OpenSandbox
# container (NetworkRule.target format). Empty = all egress denied.
# OPENSANDBOX_NETWORK_ALLOW=data.geopf.fr,api.example.com,10.0.0.1,*.internal.corp
#
# Read-only npm and PyPI mirror proxy of the command and service containers
# (sandbox_run_command, sandbox_start_service), e.g. the nginx of
# backend/sandbox/registry-mirror/nginx.conf. Set, its host joins their egress
# allow-list and npm, Yarn, pip and uv install through it; keep the public
# registries out of OPENSANDBOX_NETWORK_ALLOW. Empty = off (offline installs
# from the image caches). No credential in the URL (refused at startup).
# SANDBOX_REGISTRY_MIRROR_URL=http://registry-mirror:8080
#
# CPU/memory requested for each OpenSandbox container (code interpreter +
# custom JS/Python tools). Passed through as-is to the OpenSandbox SDK's
# resource argument - use whatever unit strings it/the underlying runtime
# expects (e.g. "1" or "500m" for CPU, "128Mi" or "1Gi" for memory).
# WARNING: if using the Kubernetes `Pool` CRD for warm-pool pre-provisioning
# (see dev-docs/opensandbox-pool-management.md), these values must stay
# byte-identical to the `resources.requests` in your `Pool` manifests -
# changing this without updating those manifests silently falls back to a
# cold sandbox create every time, with no error.
# A bare value applies to every image key; per-key values follow the
# OPENSANDBOX_IMAGES convention ("1,python-dev:2", "128Mi,python-dev:2Gi":
# the entry without a key is the default). The dev images of
# sandbox_run_command (python-dev, nodejs-dev) need more than the defaults.
# SANDBOX_CPU=1
# SANDBOX_RAM=128Mi
#
# Per-user sandbox usage counting: every successful OpenSandbox-routed call
# (code interpreter + custom tools) increments a quota_usage row for that
# user (usage_type="sandbox"), alongside the existing LLM-proxy/agentic
# usage counters, and shares the per-user agentic quota as its enforcement
# ceiling. On by default. Set true for self-hosted/on-prem deployments that
# manage their own sandbox infrastructure independently of hosted
# usage-based billing. Restart required to take effect.
# DISABLE_SANDBOX_QUOTA_USAGE=false
#
# MCP OAuth Dynamic Client Registration (RFC 7591). The MCP spec requires
# POST /mcp/oauth/register to stay unauthenticated (clients self-register
# before any user session exists), so it is hardened with a per-IP rate
# limit and a bounded client table instead of a login gate. Operators who
# do not use MCP OAuth at all can disable registration entirely (the
# endpoint then returns 403).
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# MCP_DCR_ENABLED=true
# Upper bound on dynamically registered OAuth clients; at the cap the
# oldest registrations are evicted (RFC 7591 clients re-register
# transparently). Values below 1 are clamped to 1.
# MCP_DCR_MAX_CLIENTS=500
# Registrations per hour from one client IP. A hosted client (claude.ai,
# ChatGPT) registers one client per fresh connection from its provider's
# addresses: raise it when many people connect from one. Below 1 = 1.
# MCP_DCR_RATE_LIMIT=5
# OAuth Client ID Metadata Documents (MCP 2025-11-25): a client names its
# own HTTPS metadata document as its client_id instead of registering
# (claude.ai, Claude Code, VS Code). The platform fetches it from a public
# address only, bounded and cached. false refuses such clients.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# MCP_CIMD_ENABLED=true
# The other direction: when connecting to a REMOTE MCP server over OAuth with
# no client_id configured, the platform discovers the authorization server
# (RFC 9728 + RFC 8414) and registers itself dynamically (RFC 7591), so a
# server can be added from its URL alone. Set false to require every OAuth
# client to be provisioned by hand.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# MCP_OUTBOUND_DCR_ENABLED=true
#
# Enable AI Catalog browsing/publishing (disabled by default for MVP)
# AI_CATALOG_ENABLED=true
#
# Platform Health spends outside the agentic quota, bounded only by its own
# spend ceilings (Budget, Analysis, Module Analyst). Locked by default: those
# ceilings stay at their built-in defaults, read-only in Settings > Platform
# Health, and a write to them is refused; a stored value is kept, not applied.
# Set true to apply the stored values and edit them again. Restart required.
# PLATFORM_HEALTH_SPEND_LIMITS_UNLOCKED=false
#
# Keep every agent tool of an admin (the agent builder, the flow builder, the
# trace inspection and the work-items delegation, in chat and on the XTM One
# MCP server) to the admin's three tiers: agents, assignments, runs, traces,
# flows, evaluations, knowledge bases. Default false: an admin's agent reaches
# everything, as the admin does in the UI and REST API.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# AGENT_TOOLS_STRICT_ADMIN_ACCESS=true
#
# The tools whose results the connected prompt guard (Nova) screens,
# comma-separated registered tool names, and custom:<id> for a custom tool.
# A rule match is recorded in the audit log and the result is left as it is.
# Default empty: nothing screened.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# PROMPT_GUARD_SCANNED_TOOLS=web_fetch,search_jira_issues
# Withhold a screened result a block rule matches (the agent waits for the
# verdict of each screened result). Default false: log only.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# PROMPT_GUARD_BLOCK_TOOL_RESULTS=true
#
# Public chat widget: show only the images the platform serves in an answer
# (any other image becomes a link), open every answer link in a new tab, and
# drop inline styles, presentational markup, SVG / MathML and links other than
# http(s) / mailto / tel. Default false: answers render as they always did
# (script is removed in both modes).
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# PUBLIC_WIDGET_STRICT_RENDERING=true
#
# Public chat widget visitor uploads (off per widget until its owner allows
# them): the files a visitor attached are deleted once their conversation has
# had no message for this many days (a file never sent, after a day). Min 1.
# PUBLIC_WIDGET_UPLOAD_RETENTION_DAYS=7
#
# SVGs a model is shown (a chat upload, a user-message image, a tool result):
# refuse, instead of rendering with the reference dropped, an SVG that declares
# an XML entity or references anything outside itself (a file path, a URL,
# another document). Nothing is fetched or read from disk in either mode.
# SVG_STRICT_RENDERING=true

# Prompt guards (Nova) on the General Assistant and the public widget: while a
# guard is connected, a message is evaluated and every rule match audited.
# Default false: the message is answered even when a block rule matched.
# True refuses it with the guard's message, as agent chat always does.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# PROMPT_GUARD_BLOCK_GENERAL_ASSISTANT=true
# PROMPT_GUARD_BLOCK_PUBLIC_WIDGET=true
#
# Prompt guards (Nova) on the model's answers: off (default, nothing is
# evaluated), log (every answer is evaluated in the background after it is
# delivered and a match audited) or block (an answer delivered whole is
# evaluated first and withheld when a block rule matches; a streamed answer
# has already been shown, so it is only audited, as in log).
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# PROMPT_GUARD_MODEL_OUTPUT=log
#
# Reject webhook deliveries for assignments WITHOUT a configured webhook_secret
# (strict enforcement, 401). Default false: secretless assignments keep working
# but log a warning. New webhook assignments auto-generate a secret at creation.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# WEBHOOK_REQUIRE_SECRET=true
#
# Refuse every Slack event / Microsoft Graph change notification the platform
# cannot authenticate. Default false: an integration with no usable Slack
# signing secret (and a Graph subscription recorded without a clientState)
# keeps receiving its events unverified, with a warning and a Security Audit
# finding. A delivery a configured secret does not prove is refused either way.
# True also limits the admin OAuth app's webhook (/api/hooks/providers/<p>) and
# the LinkedIn notification URL to the admin app's integrations the agent owner
# may use, and drops LinkedIn notifications when no client secret is configured.
# It also covers the Teams bot's private / shared channels
# (/api/channels/teams/graph-notifications): true acts only on a notification
# that proves the subscription recorded for its channel and replaces the
# subscriptions created before 2026-07-02 or whose clientState can no longer be
# decrypted; false acts on every notification earlier releases acted on, with a
# warning and a Security Audit finding, and keeps renewing those subscriptions.
# Nothing to set on upgrade: false keeps every delivery an install received.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# INTEGRATION_NOTIFICATIONS_REQUIRE_VERIFICATION=true
#
# --- Assignment run queue ---
# A delivery that finds its assignment busy - a POST /api/hooks/assignments/{id}
# delivery, a polled email, Teams or Slack message and, with
# INTEGRATION_EVENT_QUEUE_ENABLED, a pushed event - becomes a run in the
# "queued" status, so an accepted delivery produces exactly one run. Queued runs
# start the moment they are queued and whenever a run ends, up to
# ASSIGNMENT_MAX_CONCURRENT_RUNS per assignment, in turns across agents and
# assignments. Schedules, manual triggers and follow-ups keep their own overlap
# guard: they never start beside an active run.
#
# Per-assignment webhook only: queue its deliveries. Set false to restore the
# legacy behaviour, where a delivery arriving while a run was active was
# discarded and still answered 200 - the sender recorded a success for a run
# that never happened.
# ASSIGNMENT_QUEUE_ENABLED=true
# Polled integration events (email, Teams, Slack messages) always queue: a poll
# reads up to 5 pages of its provider's oldest events (15 Microsoft emails, 10
# Gmail messages, 20 Teams or Slack messages a page) and a full queue hands the
# rest back to the poller, which fetches them again on a later tick - nothing is
# dropped. Pushed events (a Slack event, a Graph or LinkedIn notification, a
# provider or agent webhook) start in a free slot; with every slot taken, false
# (default) skips them as the overlap guard always did, and true queues them,
# past the queue cap if need be.
# INTEGRATION_EVENT_QUEUE_ENABLED=false
# One run per inbound event on an agent: a second event-triggered run with the
# same dedup key (a mail's Message-ID, a calendar event and its modification
# instant, a provider event id) on the same agent within this many seconds is
# recorded as a skipped run ("skipped: duplicate of run <id>") instead of
# starting - across the agent's assignments and across delivery paths (a Graph
# notification and the poll behind it, two mailboxes the mail reached, a
# delegated pick-up naming the Message-ID). An assignment's
# trigger_config.dedup_window_seconds overrides it; 0 turns it off. Scheduled
# runs are not affected.
# ASSIGNMENT_EVENT_DEDUP_WINDOW_SECONDS=600
# One turn per chat conversation: the run of a Teams chat message or
# channel-thread reply starts this many seconds late, and a later message of
# the same sender in the same conversation that finds it still waiting joins
# its turn instead of starting a second run. Messages of one conversation run
# one at a time. trigger_config.coalesce_window_seconds overrides it (0..60);
# 0 turns the window off (the per-conversation ordering stays).
# CHAT_EVENT_COALESCE_WINDOW_SECONDS=6
# The last line behind that dedup, on the send itself: before a Microsoft mail
# tool sends (a new email, a draft, a reply), it takes a short lock on the
# conversation for the sending agent and looks for a message the agent (any of
# its runs) already sent in that conversation within this many seconds - its
# own record, then the mailbox's Sent Items - and refuses the send naming that
# message unless the tool is called with force_duplicate=true. 0 turns the
# guard off.
# MAIL_SEND_GUARD_WINDOW_SECONDS=300
# Runs of one assignment started from its queue at once, clamped to 1..50. An
# assignment's trigger_config.max_concurrent_runs overrides it, and
# trigger_config.ordering_key (a dotted path into the trigger payload, such as
# issue.number) keeps the runs sharing a value one at a time, in arrival order.
# To keep up, a cap must exceed deliveries per second x seconds a run holds its
# slot. 1 restores one run at a time.
# ASSIGNMENT_MAX_CONCURRENT_RUNS=10
# Queued runs promoted and still waiting for a worker, across the platform: the
# drain stops there, so a promoted run starts within a reconciler cycle and one
# busy assignment cannot fill the pool ahead of the others.
# 0 = MAX_CONCURRENT_RUNS.
# ASSIGNMENT_DISPATCH_MAX_PENDING_RUNS=0
# Fair share of the worker pool when a free slot claims the next run: a
# delegated run whose parent is still running first, then one run per fleet in
# turn (an agent outside any fleet is its own fleet), oldest first within a
# fleet. false = strict oldest first.
# ASSIGNMENT_FAIR_SHARE_ENABLED=true
# Share of the pool (MAX_CONCURRENT_RUNS x workers) one fleet, or one agent,
# may hold while another has runs waiting; past it, its runs go after the
# others' (never refused). 0 or 1 lifts the cap.
# ASSIGNMENT_FLEET_MAX_SHARE=0.5
# ASSIGNMENT_AGENT_MAX_SHARE=0.5
# Slots per worker above the shared pool that only a delegated child whose
# parent run is still running may take once the pool is full (parents waiting
# on their own children never deadlock it). 0 turns the reserve off.
# DELEGATION_RESERVE_SLOTS=2
# Once an assignment's oldest queued delivery has waited this many seconds, the
# drain alternates its newest and oldest deliveries so fresh work does not wait
# behind the whole backlog (nothing is dropped), and logs a warning at most once
# a minute. 0 disables both.
# ASSIGNMENT_QUEUE_BACKLOG_SECONDS=300
# Seconds an assignment's concurrency cap stays halved after one of its runs met
# an HTTP 429 (model provider or integration). A 429 met outside an assignment
# run throttles nothing; the window is not extended. 0 disables the back-off.
# ASSIGNMENT_DISPATCH_RATE_LIMIT_BACKOFF_SECONDS=60
# Max deliveries held per assignment before the overflow policy applies.
# ASSIGNMENT_QUEUE_MAX_DEPTH=20
# Per-assignment webhook only: what happens at a full queue. "reject" (default): HTTP 429 + Retry-After, so
# a sender with retry logic loses nothing. "drop_oldest": the oldest waiting
# delivery is finalized as a skipped run and the new one takes its slot.
# "drop_newest": the incoming delivery is discarded with a 200 and a warning.
# ASSIGNMENT_QUEUE_OVERFLOW_POLICY=reject
# Retry-After (seconds) returned with the "reject" policy's 429.
# ASSIGNMENT_QUEUE_RETRY_AFTER_SECONDS=30
# What happens to a connected Suite platform's tools while its assistant
# cannot display an approval prompt. A registered platform (OpenCTI / OpenAEV /
# OpenGRC) contributes tools XTM One cannot classify — they are not on the
# shipped whitelist and never can be, because we do not know what they do — so
# they ask for approval by default, everywhere, from the moment it connects.
#
# "require" (default) gates them: its agents explain themselves instead of
# acting when nobody can approve. "skip" lets them run, which is what you want
# when deploying beside a platform release that cannot prompt yet, so its
# agents keep working without an API call on first boot.
#
# Read ONCE, when a platform registers for the first time — it seeds a value an
# administrator can then see and change under Settings > Security > Tool
# approvals, rather than overriding one. Changing it later does not affect
# platforms already registered, and it never overwrites a choice an
# administrator has made.
# TOOL_APPROVALS_PLATFORM_DEFAULT=require

# The platform-wide approval kill switch. An upgrade switches approval on for
# no agent anyway (an administrator turns it on per agent, or install-wide
# under Settings > Security > Tool approvals); false additionally keeps every
# gate off.
#
# Read ONCE — on a fresh install when the settings row is created, and on an
# upgrade by the migration that adds the column. It seeds a value an
# administrator can then see and change in the same place. Changing it later
# does nothing: the stored value is what the gate reads. Unset, or set to
# something unrecognised, leaves approvals on.
# TOOL_APPROVALS_ENABLED=true

# Whether a run paused for human input holds the queue. true (default) starts
# nothing more for its assignment until the approval is answered, whatever the
# cap - bounded and visible, unlike the old silent drop. false lets queued runs
# start beside a paused run; only safe when a HITL pause leaves no half-written
# shared state.
# ASSIGNMENT_QUEUE_HOLD_ON_AWAITING_HUMAN=true
# Max assignments that start queued runs per drain. The drain runs on every
# reconciler cycle, on every enqueue and at the end of every run, so the rest
# follow within a cycle.
# ASSIGNMENT_QUEUE_DRAIN_BATCH=20
# Per-assignment webhook throttle, applied before the body is read. Raise it
# for a high-cadence alert feed — the queue still bounds how many accepted
# deliveries become runs. Over-limit deliveries get 429 + Retry-After.
# WEBHOOK_REQUESTS_PER_MINUTE=60
# Event matching of integration-event and webhook triggers. A trigger created on
# this version, or whose events are chosen again, matches its event exactly
# (pull_request never fires on pull_request_review). A trigger saved before keeps
# the old prefix match through every other edit and every copy, and says so in
# its assignment page and in the log. true applies exact matching to every
# trigger at once (it does not read the old event_type key of an agent-builder
# trigger: only that trigger's own switch does).
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# WEBHOOK_EXACT_EVENT_MATCHING=false
# Idempotency window. A delivery whose key (Idempotency-Key / X-GitHub-Delivery
# / Webhook-Id, then a provider id in the payload, then a hash of the URL scope
# + raw body) was already seen within this window replays the first delivery's
# response instead of firing a second run. Senders that send no idempotency
# header and no stable id fall back to the body hash, where two distinct events
# with identical bodies collapse into one run — shorten this below such a
# sender's event cadence, or (better) have it send an Idempotency-Key.
# WEBHOOK_DEDUP_TTL_SECONDS=300
#
# Fail mode when the backing store (Redis / DB) is unreachable while a
# rate-limit or quota check runs. "open" (default) skips the check so an
# infrastructure hiccup never blocks users; "closed" rejects the request
# (503 for rate limits, a quota-unavailable refusal for quota checks) until
# the backend recovers. Recommended "closed" for enterprise deployments
# where unmetered usage is unacceptable. Allowed values: open | closed.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# The quota fail mode applies in copilot / dev mode only: in xtm_one mode
# quotas always fail closed (they are part of the licence), whatever the
# variable says, and "open" there is ignored with a warning at startup.
# RATE_LIMIT_FAIL_MODE=open
# QUOTA_FAIL_MODE=open
#
# Agent failure pool — don't spend agentic actions on failed agent runs. One
# action is deducted from the user's action quota BEFORE the agent runs, so a
# run that ends in failure has already spent an action on work it never
# delivered. The first AGENT_FAILURE_QUOTA_POOL failures of a given
# (user, agent) pair are credited back; every failure after that spends its
# action normally, so a provider outage or a broken tool is forgiven while an
# agent that always fails keeps consuming the quota once its pool is spent.
#
# The pool renews ONCE A YEAR, on the anniversary of the Filigran license (falling
# back to this platform instance's creation date, then to the calendar year).
# An admin can recharge every pool before that date by redeeming a
# Filigran-signed support code in Settings > Quotas — codes are verified
# offline against the license trust anchor already in the image and are
# single-use.
#
# The pool is per agent AND per user (one user's failures never eat another's
# on a company-managed agent) and covers chat turns, assignment runs,
# sub-agent tasks, flow agent steps and browser-extension tasks — not the
# General Assistant, which has no agent to pool against.
#
# One gap, so this list is not read as more than it is: a FLOW abandoned by the
# orchestration engine mid-run (worker lost, lease expired) keeps its actions
# charged. A flow's agent step is credited back like any other when it fails on
# its own, but a flow meters one action per agent node, so the per-run proof of
# charge that covers assignment runs and sub-agent tasks does not describe it.
#
# A run that never reached a model at all (provider unreachable, down, or no
# provider configured) is a separate case: its action is credited back FREE,
# outside the pool and without limit, and that behaviour is NOT gated by the
# flag below — sizing the pool has nothing to say about an outage on this side.
# Anything the provider REPLIES stays on the pool side: a rate limit (429), a
# rejected credential (401), an account out of credit. Those are persistent and
# reproducible, so forgiving them without a bound would stop the quota metering
# for as long as they last. Settings > Quotas reports the two reasons apart.
#
# ON by default — spending an action on a run the platform failed to deliver is
# the wrong default, and the pool is what stops that from becoming free
# unlimited retries; set the flag to false (or the pool to 0) to deduct an
# action for every failure, like a success. Sizing is env-only (an operator decision, not a
# tenant-administrator one) and requires a restart; the admin UI is read-only
# apart from redeeming a support code.
# AGENT_FAILURE_QUOTA_REFUND_ENABLED=true
# AGENT_FAILURE_QUOTA_POOL=5
#
# Platform feature flags (dev/experimental features). Comma-separated flag
# ids, e.g. "MY_FLAG,OTHER_FLAG". Use "*" to enable every known flag at once.
# Unset/empty = NO flags enabled (fail-closed default). Requires a restart
# to change — there is no admin UI toggle by design (kept out of Settings
# so it never confuses regular admins). An unknown flag id (e.g. left over
# from another branch) is logged as a warning and ignored — it never enables
# anything and never prevents startup. See backend/app/core/feature_flags.py.
# VIDEO_STUDIO turns the Video Studio on: size the worker for its renders first
# (docs/docs/deployment/configuration.md, "Video Studio").
# MOBILE_COMPANION turns the mobile companion on: a phone gets the companion
# app, linked phones get notifications, and the companion PIN lock applies.
# ENABLED_FEATURES=
# Expose financial cost amounts in observability UI (Analytics, Traces,
# agent Observability). Set to false to mask costs as "--$" with a tooltip.
# OBSERVABILITY_COST_DATA_ENABLED=true
# -----------------------------------------------------------------------------
# 1f. AI PROVIDERS  (optional – pre-provision LLM providers from env vars)
# -----------------------------------------------------------------------------
#
# On every startup, the platform upserts LLM provider configs from these env vars:
# the API key is re-applied from the env (env wins), the provider is marked
# env-seeded (amber "Env" badge in Settings -> AI Models, cannot be deleted from
# the UI — the seed would recreate it) and, when LLM_PROVIDER_{PROVIDER}_MODELS
# is set, the model catalog is handled as described under
# LLM_PROVIDER_MODELS_EDITABLE below. Removing the env var and restarting
# removes the provider again (with cleanup of the agents / defaults that used it).
#
# Pattern:
#   LLM_PROVIDER_{PROVIDER}_API_KEY=<key>
#   LLM_PROVIDER_{PROVIDER}_MODELS=<model1,model2,...>  (optional, comma-separated)
#
# Supported providers (uppercase in env var):
#   OPENAI, ANTHROPIC, GEMINI, OPENROUTER, OLLAMA, MISTRAL,
#   AZURE_OPENAI, BEDROCK, LITELLM, CUSTOM_OPENAI, FILIGRAN_GATEWAY
#
# Credential formats:
#   OPENAI:         sk-...
#   ANTHROPIC:      sk-ant-...
#   GEMINI:         AIza...
#   OPENROUTER:     sk-or-...
#   OLLAMA:         http://localhost:11434  (server URL, not an API key)
#   MISTRAL:        API key
#   AZURE_OPENAI:   endpoint||api_key||api_version
#   BEDROCK:        aws_access_key||aws_secret_key||region
#   LITELLM:        api_key||base_url
#   CUSTOM_OPENAI:  api_key||base_url
#   FILIGRAN_GATEWAY: url[||target_provider[||token]]  (URL first, unlike CUSTOM_OPENAI;
#                     no token = signed XTM JWT; no target but a token: url||||token)

# LLM_PROVIDER_OPENAI_API_KEY=
# LLM_PROVIDER_OPENAI_MODELS=gpt-4.1,gpt-4.1-mini,o4-mini

# LLM_PROVIDER_ANTHROPIC_API_KEY=
# LLM_PROVIDER_ANTHROPIC_MODELS=claude-sonnet-5,claude-haiku-4-5-20251001

# Single platform-wide default model used by all agents and the General Assistant.
# Resolution: on boot, the backend first looks for the model in one of the env-seeded
# provider MODELS lists above; if no env-seeded provider carries it, it falls back to
# any existing DB provider whose available_models lists the model (env-seeded or
# UI-configured, deterministic by created_at DESC). The model just needs to exist in
# *some* configured provider's available_models — env-seeded providers take precedence
# so flipping the default by editing this env var keeps working alongside UI-managed
# providers. A WARNING is logged at boot if no provider carries the model.
# When set, the Settings → AI Models "Agent LLM Models" control becomes
# read-only (env-managed) and shows an "Env" lock badge — unless
# BYOLLM_ACTIVATED=true, where this value only furnishes an install that has no
# LLM configuration yet and the control stays editable.
# DEFAULT_MODEL=gpt-4.1

# Optional default chat model for the General Assistant specifically (distinct
# from DEFAULT_MODEL, which is the agent default). When set, it is re-seeded
# into the General Assistant on every startup (env wins) and the Settings →
# General Assistant "Chat Model" control becomes read-only (env-managed) with
# an "Env" lock badge. When NOT set, the General Assistant chat model defaults
# to "Agent default" (it follows DEFAULT_MODEL / the platform agent default)
# and stays admin-configurable. Must be a chat model that resolves to a
# configured provider.
# DEFAULT_GENERAL_ASSISTANT_MODEL=claude-sonnet-4-6

# If true, ALL LLM provider management from the admin UI/API is disabled
# (add, edit, rename, delete) — POST/PUT/DELETE on /api/v1/settings/llm-providers
# return 403. Providers must be defined only through LLM_PROVIDER_*
# environment variables and the backend must be restarted to apply changes.
# MODELS_ENV_PROVIDING_ONLY=true

# Who owns the model catalog of an env-seeded provider (LLM_PROVIDER_*_API_KEY).
#
# false (default) — PINNED: LLM_PROVIDER_{PROVIDER}_MODELS IS the catalog. It
#   overwrites the provider's available models and default model on every boot,
#   the Settings -> AI Models "Models" editor is hidden for that provider and
#   PUT /api/v1/settings/llm-providers/{id} refuses available_models /
#   default_model changes with a 403 that names this variable.
# true — EDITABLE: LLM_PROVIDER_{PROVIDER}_MODELS is a BASELINE. It seeds the
#   catalog on first boot, then on every restart only the *difference* with the
#   list applied at the previous boot is folded in: models added to the env var
#   are added, models removed from it are removed (with the usual cleanup of the
#   agents / user preferences / platform defaults that pointed at them), every
#   other admin edit made in Settings -> AI Models is preserved. The "Models"
#   editor (and rename) are unlocked for env-seeded providers; the API key stays
#   env-managed and the provider still cannot be deleted from the UI.
#
# In both modes a provider WITHOUT LLM_PROVIDER_{PROVIDER}_MODELS keeps its
# stored catalog untouched by the seed. Has no effect under
# MODELS_ENV_PROVIDING_ONLY=true, which blocks every provider mutation.
# A provider that lists no model chats on its built-in chat model only while no
# configured provider lists one, so a key set for the image, video, speech or
# music models alone (DEFAULT_*_PROVIDER) needs no model list: next to
# providers whose models are listed, it takes no chat and no failover.
# DEFAULT_MODEL is still re-applied on every boot, but only when a configured
# provider still offers it (otherwise a WARNING is logged and the platform
# default is left unchanged) — a model an admin removed from the catalog does
# not come back as the platform default.
# LLM_PROVIDER_MODELS_EDITABLE=false

# BYOLLM — "bring your own LLM". The LLM configuration of the install belongs
# to the administrator, not to the environment. Set it when the deployment
# ships at most a baseline and the tenant is expected to plug in its own
# provider and models.
#
# true:
#   * administrators add / edit / rename / delete LLM providers and their API
#     keys from Settings -> AI Models (implies LLM_PROVIDER_MODELS_EDITABLE=true
#     for the catalog of env-seeded providers, and overrides
#     MODELS_ENV_PROVIDING_ONLY=true — combining the two logs a WARNING at
#     startup naming both, and BYOLLM wins);
#   * every DEFAULT_* value (DEFAULT_MODEL, DEFAULT_GENERAL_ASSISTANT_MODEL,
#     DEFAULT_ROUTING_MODEL, DEFAULT_FALLBACK_MODEL, DEFAULT_REASONING_EFFORT,
#     DEFAULT_EMBEDDING_*, DEFAULT_IMAGE_*, DEFAULT_VIDEO_*, DEFAULT_SPEECH_*,
#     DEFAULT_MUSIC_*, DEFAULT_DECISION_*) furnishes an install that has NO
#     LLM configuration of its own yet, and nothing after that. A fresh
#     install still starts on the operator's baseline; from the first thing an
#     administrator stores, every one of these variables is inert on that
#     install and no restart can take a choice back — including the choice to
#     leave a field empty (a cleared fallback model, a routing model left on
#     the platform default, a General Assistant on "Agent default");
#   * the matching Settings -> AI Models controls stay editable (no "Env" lock
#     badge), including the embedding and image defaults. Changing the embedding
#     model from the UI resets and re-embeds the knowledge bases, which the
#     env-seed path does NOT do — that is why this is an explicit opt-in.
#
# The unit is the install, not the field: an install counts as configured as
# soon as it stores an agent default model, a routing or fallback model, a
# reasoning effort, an embedding, image, video, speech, music or decision
# model, or a General Assistant chat model. An agent, embedding or image model
# the platform picked itself from an env-seeded provider (its first chat model,
# its built-in embedding or image model) does not count, so a DEFAULT_* added
# after a first boot with provider keys alone is still applied. On a configured
# install the platform no longer fills an empty default from its providers
# either. Clearing one field afterwards does NOT hand it back to the baseline;
# to re-apply the environment, clear the lot.
#
# false (default): every DEFAULT_* is re-applied on every boot (env wins) and
# the corresponding controls are read-only with an "Env" badge.
#
# Provider CREDENTIALS stay env-managed either way: LLM_PROVIDER_{P}_API_KEY is
# re-applied on every boot, and an env-seeded provider deleted from the UI
# comes back at the next restart while its API-key variable is still set —
# removing the variable is what removes the provider. BYOLLM is about who
# chooses the models and the defaults, not about who holds an operator's key.
# The seeded agents carry no model of their own, so they follow the platform
# default the administrator picks.
# BYOLLM_ACTIVATED=false

# Optional routing evaluator model (used for mandatory-transfer condition matching).
# When empty, routing uses the platform default model resolution.
# DEFAULT_ROUTING_MODEL=gpt-4.1-mini

# Optional platform-wide fallback model. When the primary model fails (rate limit,
# overload, or a transient provider error) after retries are exhausted, the failover
# layer tries this exact model first (on its owning provider) before falling back to
# other providers' default models. The model must exist in some configured provider's
# available_models. When set, the Settings -> AI Models "Fallback Model" control
# becomes read-only (env-managed) and shows an "Env" lock badge.
# DEFAULT_FALLBACK_MODEL=gpt-4.1

# Platform-wide default reasoning effort for thinking/reasoning models
# (OpenAI o-series, Anthropic Opus, Gemini 2.5). Agents can still override it
# per-agent. When set, the Settings → AI Models "Default Reasoning Effort"
# control becomes read-only (env-managed), like the env-seeded default model.
# Valid values: low | medium | high | max (empty = use the provider default).
# DEFAULT_REASONING_EFFORT=high

# Wait policy of every agent run (the ``wait`` tool), in seconds: the longest
# single pause and the total one run may spend waiting. When set, the
# Settings > AI > Agent runs controls become read-only (env-managed).
# Unset = the value saved in Settings (default 300 / 1800). Ceilings: 3600 / 86400.
# AGENT_MAXIMUM_WAIT_TIME=300
# AGENT_MAXIMUM_TOTAL_WAIT_TIME=1800

# Anthropic prompt caching (direct Anthropic provider). Enabled by default:
# tool definitions and the system prompt get explicit cache breakpoints and the
# growing conversation is cached automatically, so repeated prefixes across
# agentic-loop iterations and chat turns are billed at the cache-read rate
# (0.1x input) instead of the full input rate. Cache reads are also not
# deducted from Anthropic rate limits. Set to false to disable entirely.
# PROMPT_CACHING_ENABLED=true
# Cache TTL: 5m (default, refreshed free on every hit) or 1h (2x write cost;
# use when follow-up requests routinely arrive more than 5 minutes apart,
# e.g. slow human-in-the-loop or external channel conversations).
# PROMPT_CACHE_TTL=5m

# Anthropic thinking replay (direct Anthropic provider). Off by default. When
# on, the thinking blocks of the current tool round are handed back to the
# models that think by default (Claude Sonnet 5, Opus 5, Fable 5, Mythos), so a
# tool round resumes with the reasoning that asked for the tools. A turn's
# blocks are re-sent verbatim only while the system prompt, the tools and the
# earlier messages are exactly those they were produced under, and a request
# the API refuses over them is sent again without them. Every LLM generation
# whose request carries earlier thinking records what was re-sent and why not
# in its "thinking_replay" trace metadata (with the setting off too).
# ANTHROPIC_THINKING_REPLAY_ENABLED=false

# Override default embedding/image models (auto-detected from first provider if not set).
# Both the embedding and image defaults are re-applied on every startup (env wins),
# so when set the Settings → AI Models "Embedding" and "Image Generation" controls
# become read-only (env-managed) and show an "Env" lock badge.
# NOTE: changing DEFAULT_EMBEDDING_MODEL/DIMENSIONS to a different vector space after
# knowledge-base documents are ingested requires re-embedding those documents.
# DEFAULT_EMBEDDING_PROVIDER=openai
# DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# For custom_openai / litellm embedding endpoints, set the base URL separately:
# DEFAULT_EMBEDDING_PROVIDER=custom_openai
# DEFAULT_EMBEDDING_PROVIDER_BASE_URL=https://my-embedding-server.example.com/v1
# DEFAULT_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Override vector dimensions (Matryoshka / variable-dim models only):
# DEFAULT_EMBEDDING_DIMENSIONS=3072

# For custom_openai / litellm image endpoints, set the base URL separately:
# DEFAULT_IMAGE_PROVIDER_BASE_URL=https://my-image-server.example.com/v1
# DEFAULT_IMAGE_PROVIDER=openai
# DEFAULT_IMAGE_MODEL=gpt-image-1

# Video, speech, music and decision models, pinned like the image model.
# DEFAULT_<ROLE>_PROVIDER is a provider type (openai, gemini, elevenlabs,
# litellm, ...) that must be configured (an LLM_PROVIDER_*_API_KEY above, or a
# provider added in Settings -> AI Models). DEFAULT_<ROLE>_MODEL is the model it
# serves; leave it empty for video, speech and music to take that provider's
# built-in model, which follows the platform's releases.
# Re-applied on every startup (env wins): the matching Settings -> AI Models
# section becomes read-only and shows an "Env" lock badge. Under
# BYOLLM_ACTIVATED=true they only furnish an install with no LLM configuration
# yet. A provider type that does not serve the capability or has no model to
# pin, and a model or voice set without its provider, are logged at WARNING,
# the stored choice is kept and the section stays editable. A provider type
# that serves it but is not configured is logged too and keeps the section
# locked until that provider is configured and the platform restarts.
# DEFAULT_VIDEO_PROVIDER=gemini
# DEFAULT_VIDEO_MODEL=gemini-omni-1.1-flash
# DEFAULT_SPEECH_PROVIDER=openai
# DEFAULT_SPEECH_MODEL=tts-1-hd
# DEFAULT_SPEECH_VOICE=alloy                # a voice id or name of that provider; empty = its first voice
# DEFAULT_MUSIC_PROVIDER=gemini
# DEFAULT_MUSIC_MODEL=lyria-3.5
# Decision model (agents acting on the host page of an embedded chat): the
# provider type must serve decision models (listed under
# DEFAULT_DECISION_PROVIDER in docs/docs/deployment/configuration.md) and the
# model is required.
# DEFAULT_DECISION_PROVIDER=ollama
# DEFAULT_DECISION_MODEL=tev1:4b

# -----------------------------------------------------------------------------
# 1f-2. LOCAL TRACE STORAGE BACKEND (optional)
# -----------------------------------------------------------------------------
#
# Local traces are always written to PostgreSQL by default (same DB as the
# stack). To use a dedicated ClickHouse store for trace reads and analytics,
# set TRACING_STORE_PROVIDER=clickhouse and provide ClickHouse credentials.
#
# Supported values: postgres | clickhouse
# TRACING_STORE_PROVIDER=postgres
#
# ClickHouse HTTP endpoint and credentials (required when provider=clickhouse).
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_SECURE=false
# CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=5
#
# NOTE: enabling/disabling local trace storage itself is managed by admins in
# Settings -> Observability (trace_storage_enabled). This is runtime data and
# is not configured by environment variable.
#
# Trace payloads (prompt, conversation, reasoning, tool arguments and results)
# are stored WHOLE — they are audit material and the trace store holds the only
# copy. Large payloads are moved out of the database rather than truncated:
# above the threshold below, the payload is written to object storage (the same
# S3_* bucket as file attachments) and the trace row keeps a pointer with the
# exact size, a sha256 and an excerpt. The Traces UI then offers "Load full
# payload" to fetch it on demand. Set the threshold to 0 to disable offloading
# and always store inline.
# TRACE_PAYLOAD_OFFLOAD_THRESHOLD_BYTES=1048576
#
# Inline fallback ceiling, used ONLY when object storage is unreachable: below
# it an offload failure stores the payload inline anyway (fidelity beats
# tidiness), above it the trace records that the payload could not be stored so
# the gap is visible instead of silent.
# TRACE_PAYLOAD_HARD_MAX_BYTES=33554432
#
# Images and PDFs inside a trace payload are stored the same way: each blob goes
# to object storage under traces/<trace_id>/ and the payload keeps a reference
# with its content type, byte size and sha256, so the Traces UI can render the
# exact image an agent received or produced. Set to false to replace media with
# a "[image]" placeholder instead, as the trace layer did before. The external
# Langfuse export always strips media regardless of this setting — the Langfuse
# SDK would otherwise upload every blob to its own media storage.
# TRACE_MEDIA_OFFLOAD_ENABLED=true

# Max number of evaluation runs (agent x model matrix cells) executed
# concurrently for a single parallel-mode evaluation batch. Firing the whole
# matrix at the LLM provider at once overwhelms rate limits; the resulting
# 429/529 retries back off inside each call and inflate per-run durations.
# A bounded pool keeps the provider busy without thrashing. Batches with fewer
# runs than the cap are unaffected. Set to 0 to restore unbounded behaviour.
# EVALUATION_MAX_CONCURRENT_RUNS=5

# -----------------------------------------------------------------------------
# 1g. LANGFUSE OBSERVABILITY  (optional – pre-provision Langfuse from env vars)
# -----------------------------------------------------------------------------
#
# When LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY are both set, the platform
# creates or overwrites the Langfuse config in the database on every startup
# and enables tracing automatically.  Env vars always take precedence over
# settings configured via the UI.
#
# LANGFUSE_HOST defaults to https://cloud.langfuse.com (Langfuse Cloud).
# Set it to your self-hosted Langfuse URL when running your own instance.
#
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
#
# OpenTelemetry batch sizing used by the Langfuse SDK's OTLP exporter.
# Smaller export batches reduce risk of HTTP 413 (Request Entity Too Large)
# from collectors with strict request-body limits.
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=64
# OTEL_BSP_MAX_QUEUE_SIZE=2048

# -----------------------------------------------------------------------------
# 1g-2. PROMETHEUS METRICS (optional)
# -----------------------------------------------------------------------------
#
# Expose /metrics endpoint for Prometheus scraping.
# PROMETHEUS_ENABLED=false
#
# IMPORTANT: When PROMETHEUS_ENABLED is set to true, you MUST define a secure 
# PROMETHEUS_BEARER_TOKEN of at least 16 characters. If this token is missing 
# or too short, the application will automatically disable Prometheus metrics.
#
# Prometheus MUST authenticate using the HTTP Authorization header 
# (`Authorization: Bearer <token>`).
# PROMETHEUS_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# 1h. TRANSACTIONAL EMAIL (SMTP)
# -----------------------------------------------------------------------------
#
# When SMTP_HOSTNAME is set, the platform will send transactional emails
# (e.g., password reset links, user invitations). If left empty, the platform
# will gracefully block or skip email sending for these actions.
#
# Port 587 (STARTTLS) and Port 465 (Implicit TLS) are both supported.
# The default configuration suits a 587 STARTTLS server.
# For a 465 server, set SMTP_USE_TLS=true.
#
# SMTP_HOSTNAME=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME="XTM One"
# SMTP_USE_TLS=false
# SMTP_STARTTLS=true
#
# Model catalog announcements. When a boot (or switching AI on) finds
# that the env-managed model catalog changed (DEFAULT_MODEL or an
# LLM_PROVIDER_<P>_MODELS list), the platform emails its users the new default
# model, the models now available and the ones retired. Opt-in, and only with
# SMTP configured; the boot that records a change decides, and a change recorded
# while it was off is sent by a later boot that has both, within 7 days. What
# became of each change is logged at WARNING. RECIPIENTS is all (active users)
# or admins; the bootstrap ADMIN_EMAIL account is never emailed. BATCH_SIZE caps
# the emails sent per minute (SMTP accounts are capped per hour). SETTLE_MINUTES
# (0-1440) is how long the env catalog must stay unchanged before its change is
# emailed: every env change deployed meanwhile joins the same email and restarts
# the wait (0 = from the next minute). Admins can
# also email the users from Settings > AI Models, whatever these say.
# CHANGES_WINDOW_HOURS (1-168) is how far back the model list saves an admin has
# not emailed yet are combined into the changes Settings offers to email.
# MODEL_ANNOUNCEMENT_EMAILS_DISABLED=true turns every model announcement email
# off platform-wide: the ones above and the ones admins send from Settings. A
# boot with it on closes the queued ones unsent and Settings stops offering to
# email the users; the changes are still recorded.
# MODEL_ANNOUNCEMENT_EMAILS_DISABLED=false
# MODEL_CATALOG_EMAILS_ENABLED=false
# MODEL_CATALOG_EMAILS_RECIPIENTS=all
# MODEL_CATALOG_EMAILS_BATCH_SIZE=20
# MODEL_CATALOG_EMAILS_SETTLE_MINUTES=30
# MODEL_CATALOG_CHANGES_WINDOW_HOURS=24

# -----------------------------------------------------------------------------
# 1i. SECRET VAULTS
# -----------------------------------------------------------------------------
#
# Optional. A secret field (integration API key or client secret, MCP server
# header or environment variable, LLM provider API key, secret variable,
# channel bot token) may hold vault://<provider>/<path>#<key> instead of the
# value: the platform reads it from your vault when it is used, keeps it in
# memory for SECRET_VAULT_CACHE_SECONDS (0 = read on every use) and never
# stores it. A provider is declared here, never in the UI or the database:
#   SECRET_VAULT_<NAME>_TYPE=hashicorp|aws|gcp|azure|onepassword  (+ the settings of its type)
# Its own credentials come from the environment or the workload identity (a
# token file, an AppRole, a Kubernetes service account, an IAM role, GKE
# Workload Identity, an Azure managed identity). WRITERS (admins, the default,
# or all) is who may write a reference to it; PATHS limits the secret paths
# references may read (comma-separated prefixes). Every setting:
# docs/docs/deployment/secret-vaults.md.
#
# SECRET_VAULT_CACHE_SECONDS=300
#
# A vault connected in Settings > Security > Secret vaults is never reached on
# a loopback, link-local, reserved or cloud metadata address; private
# networks are. Origins listed here may be reached on loopback (an on-host
# vault). Environment only; comma-separated scheme://host[:port]:
# SECRET_VAULT_TRUSTED_ORIGINS=http://127.0.0.1:8200
#
# HashiCorp Vault (KV v2 mounted at secret/), referenced as vault://corp/secret/xtm-one/github#token:
# SECRET_VAULT_CORP_TYPE=hashicorp
# SECRET_VAULT_CORP_ADDRESS=https://vault.example.com:8200
# SECRET_VAULT_CORP_AUTH_METHOD=token
# SECRET_VAULT_CORP_TOKEN_FILE=/run/secrets/vault-token
# SECRET_VAULT_CORP_WRITERS=admins
# SECRET_VAULT_CORP_PATHS=secret/xtm-one
#
# AWS Secrets Manager with the platform's IAM role, referenced as vault://aws/prod/github#token:
# SECRET_VAULT_AWS_TYPE=aws
# SECRET_VAULT_AWS_REGION=eu-west-1

# -----------------------------------------------------------------------------
# 2. APPLICATION
# -----------------------------------------------------------------------------

# Secret used for JWT signing and Fernet encryption of stored tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string-in-production

# Mandatory admin user – created/overwritten on every startup.
# Web-embedded agent consumption is billed to this account.
ADMIN_EMAIL=admin@filigran.io
ADMIN_PASSWORD=change-me-in-production

# Optional programmatic admin token. Provisioned on startup. Must start with "fcp-"
# and meet the backend minimum-length requirement of 32 chars.
# ADMIN_TOKEN=fcp-change-me-in-production

# Enable debug mode (verbose logging, auto-reload). Never true in prod.
# DEBUG=false

# Backend log level: "debug", "info", "warning", "error", "critical".
# Empty = auto (debug when DEBUG=true, info otherwise).
# LOG_LEVEL=info

# Log format: "json" for structured JSON lines, "console" for colored human output.
# Empty = auto (json in production, console when DEBUG=true).
# LOG_FORMAT=json

# Frontend (Vite) log level: "info", "warn", "error", "silent".
# Controls Vite dev server verbosity. Default: "info".
# VITE_LOG_LEVEL=info

# Public URL where the platform is reachable (used for OAuth redirect URIs,
# SAML ACS URLs, and the LLM proxy endpoint shown in Profile → API Keys).
# - Docker Compose: http://localhost:4000 (FastAPI serves /api, /v1 and the frontend)
# - Dev mode:       http://localhost:8100 (backend directly) or http://localhost:3100 (Vite proxies /api and /v1)
# Leave commented for the Docker quick start and dev mode: docker-compose.yml
# defaults to http://localhost:4000, docker-compose.dev.yml to
# http://localhost:8100 (DEV_PLATFORM_PORT).
# BASE_URL=http://localhost:8100

# Frontend public URL (where the backend redirects after OAuth / SSO completes).
# Use http://localhost:3100 for dev mode, http://localhost:4000 for Docker Compose.
# Leave commented for the Docker quick start and dev mode: docker-compose.yml
# defaults to http://localhost:4000, docker-compose.dev.yml to
# http://localhost:3100 (DEV_FRONTEND_PORT).
# FRONTEND_URL=http://localhost:3100

# URL path prefix when a reverse proxy serves the platform somewhere other than
# the root of its host - "/xtm-one" for https://intranet.example.com/xtm-one/.
# Leave empty (the default) when the platform is reached at "/". Works whether
# the proxy forwards the prefix to the platform or strips it. BASE_URL (and
# FRONTEND_URL) must then include the same prefix, because every absolute link
# the platform hands out - OAuth callbacks, webhook URLs, SSO redirects,
# e-mails - is built from them; a mismatch is logged at startup. The prefix is
# a plain path (ASCII letters, digits, "-", "_", ".", "~" between slashes; no
# percent-encoding); one that collides with a namespace the platform serves
# itself (/api, /v1, /mcp, /xtm, /a2a, /office, /metrics, /assets,
# /.well-known) or with the name of one of its static files (/favicon.ico,
# /logos, /robots.txt, ...) is refused at startup.
# BASE_PATH=/xtm-one

# What the reverse proxy does with the prefix. "auto" (the default) infers the
# shape of every request - an X-Forwarded-Prefix header naming BASE_PATH says
# the proxy stripped it, otherwise a path under the prefix was forwarded - and
# refuses at startup a BASE_PATH that is also the address of a platform page
# (/tools, /agents, /chat, ...), which that inference cannot resolve behind a
# stripping proxy. Declare the proxy to lift the refusal: "forwarded" when it
# keeps the prefix, "stripped" when it removes it and sends X-Forwarded-Prefix
# (Traefik's StripPrefix does; nginx needs proxy_set_header X-Forwarded-Prefix).
# BASE_PATH_MODE=auto

# Content-Security-Policy on every HTML page the platform serves. "report-only"
# (the default) blocks nothing: browsers only report what the policy would have
# blocked, to /api/v1/csp-report, where the reports are counted and logged
# (aggregated, URLs without their query string). "enforce" sends the same
# policy as Content-Security-Policy, so browsers block what it does not allow;
# switch once the reports are clean. "off" sends no policy. A typo fails
# startup. See the Security headers page of the deployment docs.
# CONTENT_SECURITY_POLICY_MODE=report-only

# Origins, besides the platform itself and the OpenCTI / OpenAEV platforms
# registered with it (those only when PLATFORM_REGISTRATION_TOKEN is a value of
# your own, at most 20), that may show the platform's pages in an iframe once
# the policy is enforced - e.g. an intranet portal embedding XTM One.
# Comma-separated CSP sources such as https://portal.example.com or
# https://*.example.com; a malformed entry fails startup, and one that admits
# every site (*, https:, https://*) is accepted but logged as a warning at
# startup.
# CONTENT_SECURITY_POLICY_FRAME_ANCESTORS=

# Origin the platform's own headless Chromium loads a presentation's static
# render page from when exporting a deck to PDF / PowerPoint. Leave empty for
# the automatic choice: the unified image (which serves the frontend itself)
# uses its own loopback address, http://127.0.0.1:4000, and a split dev setup
# falls back to FRONTEND_URL. Set it explicitly when the platform sits behind an
# ingress the pod cannot reach, or behind an auth proxy that would intercept the
# render page (the short-lived render token is that page's only credential).
# PRESENTATION_RENDER_BASE_URL=http://xtm-one-platform.internal:4000

# Layout check of a deck right after an agent saves it: the same headless
# Chromium renders the slides and measures what the schema cannot see - a body
# shrunk to fit the slide, text cut by its box, text painted past the canvas -
# and the findings go back to the agent in the tool result so it fixes the
# slide before answering (default: true). Set to false to skip the check
# everywhere (tool result, get_presentation, POST .../layout-check; the viewer
# then offers no Layout check button), e.g. on a deployment where the headless
# browser is not available.
# PRESENTATION_LAYOUT_CHECK_ENABLED=true

# Public links of presentations: whoever manages a deck may give it a
# link anyone can open read-only, without an account (default: true). Set to
# false to turn every public link off at once and refuse new ones; the links
# are kept, so setting it back restores those that were not turned off.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# PRESENTATION_PUBLIC_LINKS_ENABLED=true

# Public links of videos: whoever manages a video may give it a link
# anyone can watch, and optionally download, without an account (default:
# true). Set to false to turn every public video link off at once and refuse
# new ones; the links are kept, so setting it back restores them.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# VIDEO_PUBLIC_LINKS_ENABLED=true

# Published links of custom dashboards: whoever manages a dashboard may publish
# it as a link anyone can open without an account, showing a snapshot of its
# data read with the publisher's access (default: false). Set to true to allow
# them; setting it back to false turns every published link off at once and
# refuses new ones, keeping the links so that true restores them.
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# DASHBOARD_PUBLIC_LINKS_ENABLED=false

# Scheduled work items: every agent can schedule a one-off action from
# a chat ("post this tomorrow at 9:00") and the platform runs it at that time,
# with no assignment (default: true). Set to false to stop it platform-wide:
# the scheduling tools answer that scheduling is disabled by the administrator
# and nothing is dispatched. Also in Settings > Security: this variable, when
# set, wins and locks the field there.
# SCHEDULED_WORK_ITEMS_ENABLED=true
#
# Phone notifications: full shows the notification's title and text on a
# linked phone (encrypted end to end to it); minimal sends only "New
# notification", with no Approve / Reject button. Also in Settings > Security:
# this variable, when set, wins and locks the field there.
# PHONE_NOTIFICATION_CONTENT=full
#
# Mobile companion PIN: true makes everyone unlock the companion on their phone
# with a PIN of their own before it shows or approves anything (phone
# notifications then carry no content and no buttons). False leaves it to each
# person, in their profile. Also in Settings > Security: this variable, when
# set, wins and locks the field there.
# COMPANION_PIN_REQUIRED=false

# Work item notifications: a TEST work item (correlation key starting
# with "retest:" or "test:", title starting with "Notify retest") may only name
# one of these comma-separated targets: an address (payload.notify.user), a
# Teams chat id (payload.notify.chat_id) or team_id/channel_id (a channel); any
# other recipient is refused when the item is saved, so a platform retest never
# messages a real person. The sending account's own chat (chat_id 48:notes) is
# always allowed. Empty (default): a test item may only notify that own chat.
# WORK_ITEM_NOTIFY_TEST_RECIPIENTS=

# Work items may wait on the deployment of a change only in the repositories
# whose deployments the platform observes (owner/name, comma-separated); a
# deployment wait on any other repository is refused when the item is saved.
# WORK_ITEM_DEPLOYMENT_REPOSITORIES=XTM-One-Platform/xtm-one
# Days a blocked work item waiting on pull requests, issues, deployments or
# workflow runs may stay quiet before it shows as stale (0: the 24 h window).
# WORK_ITEM_STALE_REF_WAIT_DAYS=7

# Waiting arcade: the chat's waiting mini-game can be taken over and played as
# a full-screen Space Invaders, with a leaderboard shared by the platform's
# users (default: true). Set to false to keep only the self-playing waiting
# animation - every /api/v1/arcade route then answers 404 and nothing of the
# game is offered. This is the only switch: users cannot hide the game
# themselves, and it is left out only for a user whose system asks for
# reduced motion.
# ARCADE_ENABLED=true

# Comma-separated list of allowed CORS origins (default already includes both).
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# -----------------------------------------------------------------------------
# 3. PERFORMANCE TUNING  (tune for production workloads)
# -----------------------------------------------------------------------------
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  ⚠  CRITICAL: PostgreSQL connection budget                            │
# │                                                                        │
# │  Each uvicorn worker AND each SAQ worker creates its own connection    │
# │  pool.  If the combined pools exceed PostgreSQL max_connections you    │
# │  will get "TooManyConnectionsError" and the platform will be unable   │
# │  to serve requests.                                                    │
# │                                                                        │
# │  REQUIRED formula — verify BEFORE deploying:                           │
# │                                                                        │
# │    (DB_POOL_SIZE + DB_MAX_OVERFLOW)                                    │
# │      × (WEB_WORKERS × platform_replicas + num_saq_workers)             │
# │      + 20  (overhead: migrations, monitoring, superuser reserve)       │
# │      < PG_MAX_CONNECTIONS                                              │
# │                                                                        │
# │  A surge rollout (maxSurge: 1) runs one more platform pod next to the  │
# │  others until the old one stops: count one more platform replica.      │
# │                                                                        │
# │  Example (default pools, 4 web workers, 1 platform replica, 1 SAQ):    │
# │    (15 + 10) × (4 × 1 + 1) + 20 = 145  →  set PG_MAX_CONNECTIONS=200   │
# │  Same with 2 platform replicas:                                        │
# │    (15 + 10) × (4 × 2 + 1) + 20 = 245  →  raise PG_MAX_CONNECTIONS     │
# │                                                                        │
# │  Example (DANGEROUS — will exhaust a default PG with 100 slots):      │
# │    (30 + 20) × (4 × 1 + 1) + 20 = 270  →  needs PG_MAX_CONNECTIONS≥300 │
# │                                                                        │
# │  The platform logs a POOL OVERCOMMIT error at startup if the           │
# │  estimated max exceeds the server's max_connections. That estimate     │
# │  covers its own pod only (WEB_WORKERS + 1 SAQ worker).                 │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PRODUCTION SIZING GUIDE (200 active users)                            │
# │                                                                        │
# │  Component        │ Min        │ Recommended   │ Notes                 │
# │  ─────────────────┼────────────┼───────────────┼────────────────────── │
# │  WEB_WORKERS      │ 2          │ 4             │ 2 * CPU cores + 1    │
# │  DB_POOL_SIZE     │ 5          │ 15            │ per worker process   │
# │  DB_MAX_OVERFLOW  │ 5          │ 10            │ burst headroom       │
# │  PG_MAX_CONNS     │ 100        │ 200           │ formula above        │
# │  MAX_CONC_RUNS    │ 5          │ 10            │ ≤ 60% of pool        │
# │  MAX_CONC_TASKS   │ 3          │ 5             │ ≤ 60% of pool        │
# │  WORKER_CONCY     │ 10         │ 20            │ parallel workflow    │
# │  REDIS_MAX_CONNS  │ 30         │ 50            │ shared pool          │
# │  Backend RAM      │ 1 GB       │ 2 GB          │ per container        │
# │  Worker RAM       │ 1 GB       │ 2 GB          │ per container        │
# │  Postgres RAM     │ 1 GB       │ 2 GB          │ shared_buffers ~25%  │
# └─────────────────────────────────────────────────────────────────────────┘

# Uvicorn web workers.
# Default: 2 (a single wedged event loop cannot take down health probes for
# the whole pod). For production: 2 * CPU cores + 1.
# Each worker has its own DB/Redis connection pool.
# WEB_WORKERS=4

# Max requests per worker before recycling (prevents memory leaks). The
# replacement worker skips the migrations and seeding its container already
# applied and holds the requests it receives while it starts (about a second).
# A worker past its quota keeps serving until no agent turn runs in it (see
# MAX_REQUESTS_DEFER_SECONDS), so a recycle never cuts a chat turn.
# 0 = never recycle. Recommended for production: 10000–50000.
# MAX_REQUESTS=10000

# Random per-worker headroom added to MAX_REQUESTS. Workers boot together and
# count requests at the same rate, so without jitter they all reach the
# recycle limit within the same drain window and the pod momentarily stops
# accepting connections entirely — failing liveness/readiness probes under load.
# Default: MAX_REQUESTS / 2.
# MAX_REQUESTS_JITTER=5000

# How long, in seconds, a web worker that reached its MAX_REQUESTS quota waits
# for the agent turns running in it (chat turns, wakes, channel messages)
# before it recycles anyway; the drain then cuts the turns still running after
# GRACEFUL_TIMEOUT. 0 = recycle at the quota, cutting what runs. Default: 14400.
# MAX_REQUESTS_DEFER_SECONDS=14400

# Bounded graceful-shutdown drain in seconds (uvicorn
# --timeout-graceful-shutdown). Without a bound, a recycling worker waits
# FOREVER for open connections (long-lived SSE dashboard streams never
# complete on their own) — it stops accepting new connections but is never
# replaced, and once every worker wedges this way the pod fails its probes
# and is restarted. A chat turn still running when it ends is cut and stores
# an interrupted reply; under Kubernetes, terminationGracePeriodSeconds must
# exceed GRACEFUL_TIMEOUT + 15 s or that reply is lost too. Default: 120.
# GRACEFUL_TIMEOUT=120

# In-app per-worker concurrency limit (the real admission control).
# Overflow above this many concurrent application requests is shed with a fast
# 429 (Retry-After) instead of queuing. Health-check probes always bypass it,
# so a burst can never make Kubernetes kill a busy-but-healthy pod.
# Default: 200. Set 0 to disable (the MAX_CONCURRENCY backstop still applies).
# APP_MAX_CONCURRENCY=200

# Uvicorn protocol-level concurrency backstop (--limit-concurrency).
# Once hit, uvicorn replies 503 to EVERY request — health probes included — so
# this is kept well ABOVE APP_MAX_CONCURRENCY: the in-app limiter sheds load
# first (429, health-exempt) and this blunt 503 path is effectively never hit.
# Default: 1000.
# MAX_CONCURRENCY=1000

# WebSocket keepalive tuning (seconds).
# Increase timeout for busy pods to reduce false 1011 keepalive timeouts.
# WS_PING_INTERVAL=30
# WS_PING_TIMEOUT=120

# Database connection pool (PER PROCESS — see the connection budget above for the total).
# Total max connections = DB_POOL_SIZE + DB_MAX_OVERFLOW per process.
# Default 15/10 keeps the default concurrency caps inside the sizing rule
# (MAX_CONCURRENT_RUNS 10 + MAX_CONCURRENT_SUB_AGENT_TASKS 5 <= 0.6 * 25).
# Ensure: (pool + overflow) * (WEB_WORKERS * platform_replicas + num_saq_workers) + 20
#   < PG_MAX_CONNECTIONS, with one more platform replica during a surge rollout.
# DB_POOL_SIZE=15
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# asyncpg connection-establishment timeout (seconds). Bounds a single connect
# so a bad one fails fast (the worker then retries / self-recovers) instead of
# stalling on asyncpg's 60s default.
# DB_CONNECT_TIMEOUT=10
# How long (seconds) a new connection keeps being retried while PostgreSQL
# refuses or drops it (a restart, a failover, a Service briefly without a ready
# endpoint): requests and LLM trace writes wait instead of failing, and past it
# requests get a 503 with Retry-After instead of a 500. A timed-out connect is
# never retried. 0 disables.
# DB_CONNECT_RETRY_SECONDS=15
# Bounds (seconds) on each statement of the migration connection: a migration
# stuck on a lock or a snapshot fails startup with an error instead of holding
# the rollout silently. They replace a timeout set on the database role or the
# database for that connection; 0 keeps that one (none by default).
# MIGRATION_LOCK_TIMEOUT_SECONDS=300
# MIGRATION_STATEMENT_TIMEOUT_SECONDS=1800
# After this many seconds without completing startup, the platform logs at
# ERROR the step in progress and what blocks the migration (repeated at the
# same interval); the worker's schema wait escalates to ERROR. 0 disables.
# STARTUP_WATCHDOG_SECONDS=300

# Orchestration reconciler in-process self-recovery.
# After N consecutive failed cycles the reconciler disposes the DB connection
# pool so the next cycle builds fresh connections — recovering from a wedged
# pool (DB failover, half-open sockets) WITHOUT a pod restart.
# RECONCILER_POOL_RECOVERY_AFTER_FAILURES=3
# Last-resort restart valve: while failing, the reconciler keeps its liveness
# heartbeat fresh (so a transient DB outage causes NO restart churn and it
# self-heals when the DB returns). Only after being unable to complete a single
# cycle for this many seconds does it let the heartbeat go stale so the
# livenessProbe restarts the worker.
# RECONCILER_UNHEALTHY_RESTART_SECONDS=600

# Concurrency limits for long-running background operations.
# Each assignment run and sub-agent task holds a DB connection for the full
# duration of the agentic loop (seconds to minutes).  The combined total
# must leave headroom for API requests and other background services:
#   MAX_CONCURRENT_RUNS + MAX_CONCURRENT_SUB_AGENT_TASKS
#     ≤ (DB_POOL_SIZE + DB_MAX_OVERFLOW) * 0.6
# MAX_CONCURRENT_RUNS=10
# MAX_CONCURRENT_SUB_AGENT_TASKS=5
# OPTIONAL: spread schedule-triggered assignments over a deterministic window
# (seconds) to trickle :00 bursts in gradually. Each assignment gets a stable
# offset derived from its UUID (same offset every trigger), added to its run
# time. DEFAULT 0 = DISABLED, so scheduled runs start at (approximately) their
# scheduled time. The :00 thundering herd is already absorbed by the reconciler
# (it caps concurrency via MAX_CONCURRENT_RUNS + MAX_CONCURRENT_SUB_AGENT_TASKS
# and only claims up to free capacity per poll), so leave this at 0 unless you
# run a very large fleet and want to smear a top-of-hour burst across a window
# (e.g. 900 = up to 15 minutes) to stay under an LLM provider rate limit.
# SCHEDULED_ASSIGNMENT_SPREAD_SECONDS=0
# Per-user fan-out spread window (seconds). When a company-managed assignment
# fans out to all active users (RUN_AS_ALL_USERS, e.g. the weekly CTEM stage
# assessments), the per-user runs are spread evenly across this window instead
# of all firing at the same instant - a fan-out herd trips LLM provider rate
# limits, and runs queued behind the concurrency cap would otherwise burn
# their timeout budget while waiting and get dead-lettered as timeouts.
# ON by default (unlike the per-assignment spread above). 0 disables.
# FANOUT_SPREAD_WINDOW_SECONDS=3600
# Automatic retry of assignment runs that failed on a TRANSIENT LLM provider
# error (rate limit / quota, overload, outage, connection failure) after the
# in-call retries and provider failover were exhausted. No retry_on_failure
# opt-in needed. Each retry waits BASE * 2^attempt seconds (capped at
# MAX_DELAY) with jitter so retries don't land in the same rate-limit window.
# Set MAX to 0 to disable.
# ASSIGNMENT_TRANSIENT_RETRY_MAX=2
# ASSIGNMENT_TRANSIENT_RETRY_BASE_SECONDS=120
# ASSIGNMENT_TRANSIENT_RETRY_MAX_DELAY_SECONDS=900
# Pause an assignment whose SCHEDULED runs keep failing on a stale integration
# reference: a resource its integration reports missing in separate runs (e.g.
# a Notion database deleted or no longer shared with the integration). Such a
# run is recorded as failed and the owner is told once; after this many
# consecutive scheduled runs like it the assignment is paused. Re-enabling it
# starts a fresh count. 0 disables the pause (runs still fail and report).
# ASSIGNMENT_STALE_REFERENCE_PAUSE_AFTER=3

# PostgreSQL server tuning (docker-compose only).
# PG_MAX_CONNECTIONS=200
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE=768MB
# PG_WORK_MEM=4MB
# PG_MAINTENANCE_WORK_MEM=64MB

# Redis connection pool.
# REDIS_MAX_CONNECTIONS=50
# REDIS_SOCKET_CONNECT_TIMEOUT=5
# REDIS_SOCKET_TIMEOUT=5
# REDIS_HEALTH_CHECK_INTERVAL=15
# REDIS_RETRY_ON_TIMEOUT=true

# SAQ background worker concurrency.
# Increase for high-volume workflow execution. Each concurrent job uses
# one DB connection + one Redis connection.
# WORKER_CONCURRENCY=20
# WORKER_JOB_TIMEOUT=600

# Grace period (seconds) the SAQ worker gives in-flight jobs to finish before
# force-cancelling them on SIGTERM (rolling restarts). MUST stay ~10s below the
# orchestrator's kill deadline (K8s terminationGracePeriodSeconds, default 30s;
# Compose stop_grace_period) or the pod is SIGKILLed before the worker can run
# its shutdown hook (Redis queue close, trace flush). Do NOT size this against
# the max job runtime - it only lets short in-flight jobs complete cleanly.
# WORKER_SHUTDOWN_GRACE_PERIOD=20

# How long the worker's deployment lets a rolling restart take: the worker
# pod's terminationGracePeriodSeconds (Compose: stop_grace_period) and how long
# a new worker pod may take to start (its startup probe's initialDelaySeconds +
# failureThreshold x periodSeconds). A Video Studio render the stopping worker
# hands back waits that long for the next one. 0 = not given (30 s and 570 s).
# WORKER_TERMINATION_GRACE_SECONDS=0
# WORKER_STARTUP_SECONDS=0

# Default asyncio ThreadPoolExecutor size (web + worker). asyncpg resolves DNS
# for every new DB connection on this pool, which is ALSO shared by all
# asyncio.to_thread work (S3/MinIO, Bedrock, docx, ...). Python's default
# (min(32, cpu+4)) is too small under agentic load and can starve DB connection
# establishment, wedging the orchestration reconciler. 0 = auto
# (derive from the worker concurrency budget + DNS headroom); a positive value
# overrides. Always clamped to >= Python's default.
# DEFAULT_THREAD_POOL_MAX_WORKERS=0

# Dedicated document-parse thread pool size. CPU-bound document
# parsing (pypdf, python-docx, openpyxl, xlrd, python-pptx, HTML extraction)
# runs on its OWN small executor so a burst of multi-minute parses can neither
# block the event loop (which froze /api/health and got pods killed by the
# kubelet) nor starve the default executor above (which serves asyncpg DNS).
# Clamped to [1, 8].
# PARSE_THREAD_POOL_MAX_WORKERS=2

# Event-loop stall watchdog. When the event loop stops being
# scheduled for longer than the threshold, a sidecar thread logs a WARNING
# with the exact blocking stack (and the heartbeat task reports the observed
# lag + pending task summary once the loop resumes), so a wedged pod produces
# actionable logs instead of dying silently. Threshold clamps to [0.5, 60].
# EVENT_LOOP_WATCHDOG_ENABLED=true
# EVENT_LOOP_STALL_THRESHOLD_SECONDS=2.0

# A legacy Word .doc, an Outlook .msg or an .xls that cannot be parsed is an
# OLE2 container with no dedicated extractor: it is read as text (its body is
# stored as plain 8-bit / UTF-16 runs), which keeps it searchable in knowledge
# bases. true extracts such files to nothing instead.
# STRICT_BINARY_TEXT_EXTRACTION=false

# KB sync scheduler timeout (seconds) for a single source run.
# Increase when syncing large repositories or drives. This bounds ONE sync
# attempt's execution; it is NOT the stuck-detection window (see below).
# KB_SYNC_TIMEOUT_SECS=1800

# KB sync stale/stuck detection.
# A running sync reports a heartbeat every KB_SYNC_HEARTBEAT_INTERVAL_SECS.
# If no heartbeat is seen within KB_SYNC_STALE_AFTER_SECS the sync is judged
# stuck/orphaned (e.g. the worker was restarted) and is reset automatically.
# This is DECOUPLED from KB_SYNC_TIMEOUT_SECS so a legitimately long sync
# that keeps heartbeating is never falsely reset, while an orphaned one
# recovers in minutes instead of ~35 min. Stale window clamps to [60, 86400].
# KB_SYNC_STALE_AFTER_SECS=600
# KB_SYNC_HEARTBEAT_INTERVAL_SECS=60

# KB sync auto-retry backoff (self-healing for failed / timed-out syncs).
# Exponential: base * 2^(consecutive_failures - 1), capped, plus jitter.
# A stuck/stale reset uses the lower KB_SYNC_STALE_RETRY_MAX_DELAY_SECONDS cap
# so a transient worker restart retries promptly instead of jumping straight
# to a multi-hour delay; genuine errors use the higher cap. After
# KB_SYNC_RETRY_ALERT_THRESHOLD consecutive failures an admin alert is raised
# (KB activity event + company notification).
# KB_SYNC_RETRY_BASE_DELAY_SECONDS=300            # first retry after 5 min
# KB_SYNC_RETRY_MAX_DELAY_SECONDS=86400           # 24 h cap (genuine errors)
# KB_SYNC_STALE_RETRY_MAX_DELAY_SECONDS=1800      # 30 min cap (stuck resets)
# KB_SYNC_RETRY_JITTER_SECONDS=60                 # 0..N s random spread per retry
# KB_SYNC_RETRY_ALERT_THRESHOLD=5                 # alert after N consecutive failures

# Model prices source + periodic git sync.
# The pricing loader can consume either the native seed format
# (app/data/model_prices.json) or LiteLLM's
# model_prices_and_context_window.json map.
#
# Source resolution order:
# 1) MODEL_PRICES_SOURCE_PATH if set (highest priority)
# 2) MODEL_PRICES_GIT_SYNC_TARGET_PATH when git sync is enabled and the file exists
# 3) fallback to native app/data/model_prices.json
#
# Paths can be absolute or relative to backend/ (not repo root).
# MODEL_PRICES_SOURCE_PATH=app/data/model_prices.json
#
# Enable periodic pull of the remote JSON file into MODEL_PRICES_GIT_SYNC_TARGET_PATH,
# then re-sync llm_model_prices from that payload.
# MODEL_PRICES_GIT_SYNC_ENABLED=false
#
# Optional upstream URL. Empty uses the built-in LiteLLM staging URL.
# MODEL_PRICES_GIT_SYNC_URL=https://raw.githubusercontent.com/BerriAI/litellm/litellm_internal_staging/model_prices_and_context_window.json
#
# Local target file receiving pulled content.
# Default points to the existing seed_data JSON used for context-window metadata.
# MODEL_PRICES_GIT_SYNC_TARGET_PATH=app/agents/seed_data/model_prices_and_context_window.json
#
# Pull cadence (minutes, autonomous tick is 60s). Clamped to [1, 10080].
# MODEL_PRICES_GIT_SYNC_INTERVAL_MINUTES=360
#
# HTTP timeout per pull (seconds). Clamped to [5, 600].
# MODEL_PRICES_GIT_SYNC_TIMEOUT_SECS=30

# Embedding auto-retry (self-healing for failed documents).
# Documents that fail to embed for a retryable reason (provider down /
# misconfigured, transient error) are automatically re-embedded by the
# autonomous scheduler with exponential backoff + jitter — no manual
# reprocess. Structural failures (no extractable text) are never retried.
# EMBEDDING_AUTO_RETRY_ENABLED=true
# EMBEDDING_AUTO_RETRY_BASE_DELAY_SECONDS=300     # first retry after 5 min, doubles each attempt
# EMBEDDING_AUTO_RETRY_MAX_DELAY_SECONDS=1800     # backoff capped at 30 min
# EMBEDDING_AUTO_RETRY_JITTER_SECONDS=60          # 0..N s random spread per retry
# EMBEDDING_AUTO_RETRY_MAX_ATTEMPTS=0             # 0 = unlimited (keep retrying with capped backoff)
# EMBEDDING_AUTO_RETRY_BATCH_SIZE=100             # max docs re-enqueued per sweep tick

# Stale-embedding auto-remediation (self-healing for already-embedded docs).
# After an admin changes the embedding provider / model / dimensions,
# previously-embedded "ready" documents whose stored vectors no longer match
# the new target are automatically re-embedded by the autonomous scheduler —
# the same work the dashboard "Re-embed all" button does, without manual
# intervention. Disable to require a manual re-embed instead.
# EMBEDDING_STALE_AUTO_REMEDIATION_ENABLED=true
# EMBEDDING_STALE_REMEDIATION_BATCH_SIZE=100      # max docs re-embedded per sweep tick

# =============================================================================
# Advanced / operator tuning (optional — sensible defaults shown)
# =============================================================================
# All of the following have working defaults and rarely need changing. They are
# documented here so operators can find and tune them without reading the code.

# --- Concurrency ---
# CHANNEL_MAX_CONCURRENT_PROCESSING=10   # cap on concurrent inbound channel messages
# CHANNEL_AGENT_MENTIONS_ENABLED=false   # true = on Slack / Teams / WhatsApp / Telegram / Discord / Google Chat, an identified user's @agent-key also makes that agent answer after the routed one, when its own channel settings let it answer there (one agentic action per agent that answers); false (default) = the routed agent answers alone
# MAX_CONCURRENT_SUB_AGENT_TASKS_PER_RUN=5  # per-run delegation fan-out cap (<= MAX_CONCURRENT_SUB_AGENT_TASKS)
# AGENT_SELF_FANOUT_ENABLED=true         # allow an agent to delegate to itself (bounded fan-out)
# DECISIONS_READ_ENABLED=false          # true = the inbox, bell and decision cards read the decisions table, once GET /api/v1/decisions/backfill reports every open human gate covered; false (default) = they read each engine's own columns
# SELF_VERIFICATION_LOOP=true            # merge several updates of one calendar event / Teams message in one tool round into one provider call (one notification), and refuse a send identical to one the run or the agent made in the last 10 min (allow_duplicate overrides)

# --- Orchestration engine (worker reconciler; see dev-docs/FSM/) ---
# RECONCILER_INTERVAL_SECONDS=2.0        # base poll cadence (a Redis "wake" nudges it sooner)
# ORCHESTRATION_LEASE_SECONDS=60         # lease validity; heartbeated at lease/3 while running
# SUB_AGENT_LEASE_SECONDS=900            # lease of a background task (sub-agent delegation), renewed at lease/3: at least 3x its longest tool call, so one call never loses it (0 = ORCHESTRATION_LEASE_SECONDS)
# ORCHESTRATION_DEFAULT_MAX_ATTEMPTS=3   # claims before a crashed execution dead-letters
# ORCHESTRATION_CLAIM_BATCH=20           # max executions/outbox events claimed per adapter per tick
# ORCHESTRATION_GRACE_SECONDS=120        # extra slack added to job timeout when computing the deadline
# AI_UNAVAILABLE_HOLD_MAX_SECONDS=604800 # hold background AI work while AI or the quota store is unavailable, then fail it (0 = fail at start)
# STALE_ASSIGNMENT_RUN_SECONDS=900       # sweep runs stuck without an orchestration execution after this (the orphan threshold of a background task)
# STALE_IN_PROCESS_RUN_SECONDS=900       # tighter deadline for in-process chat tracing runs (0 = use STALE_ASSIGNMENT_RUN_SECONDS)

# --- Autonomous attack-path runs (OpenAEV Autonomous Attack Path) ---
# MAX_CONCURRENT_AUTONOMOUS_RUNS=12         # DEDICATED reconciler slots for autonomous engagements, separate from MAX_CONCURRENT_RUNS + MAX_CONCURRENT_SUB_AGENT_TASKS (0 = share that pool). Long-lived, cheaply-parked runs that can number in the dozens; raise DB_POOL_SIZE if you push this well past a dozen.
# AUTONOMOUS_BURST_MAX_CYCLES=8            # max "continue" decision cycles chained in-process under one lease before yielding to the reconciler
# AUTONOMOUS_BURST_BUDGET_SECONDS=180      # wall-clock budget for that in-process "continue" burst (whichever bound hits first yields)
# AUTONOMOUS_WAITING_INPUT_RECHECK_SECONDS=300  # periodic self-resume re-check for a run parked on waiting_input (0 = directive-driven only)
# AUTONOMOUS_WAITING_INPUT_RECHECK_MAX_SECONDS=3600  # cap of the backed-off re-check interval
# AUTONOMOUS_CANCEL_POLL_SECONDS=2         # fast poll (seconds) so an operator Stop aborts an IN-FLIGHT burst's agent loop between iterations instead of at the end of the current cycle (0 = heartbeat-only, ~lease/3)
# STALE_ASSIGNMENT_WARN_SECONDS=600      # early WARNING for orphaned runs before the sweep fails them (0 disables)

# --- Agentic loop cost controls ---
# PROGRESSIVE_TOOLS_ENABLED=true         # progressively reveal tools to the model
# PROGRESSIVE_TOOLS_MIN_TOOLS=16         # only kick in above this tool count
# --- Per-run spending budget --- one budget object per agent run,
# enforced in the agent loop with reserve -> call -> debit -> block: the
# worst-case spend of each LLM call is reserved before the call (its max
# output lowered to what the budget still covers, down to 1024 tokens), the
# actual spend debited after, and a call that cannot fit even that is refused. Every
# dimension at 0 = no budget object at all (loop behaves as before).
# Applies to assignment runs.
# AGENT_LOOP_MAX_COST_USD=0            # hard per-run USD ceiling. Needs a price row for the model in llm_model_prices (seeded from the LiteLLM catalogue); with no price, cost is NOT enforced (a WARNING is logged) and the other dimensions still apply.
# AGENT_LOOP_MAX_TOTAL_TOKENS=0        # hard per-run token budget (0 = unlimited). NOTE: with the budget active this is a HARD block on the next call, not the soft tool-stripping wind-down it used to be.
# AGENT_LOOP_MAX_TOOL_CALLS=0          # per-run tool-call budget (0 = unlimited): once it is reached the next LLM call is refused. Distinct from max_iterations: one iteration can fan out into many parallel calls, and a batch that crosses the budget still runs in full unless AGENT_LOOP_MAX_TOOL_CALLS_STRICT=true.
# AGENT_LOOP_MAX_TOOL_CALLS_STRICT=false  # cut a parallel batch that crosses the tool-call budget (this one, or a per-agent / per-flow limit) to the calls left: the calls past it are answered "Not executed" instead of run. Off by default, as before: the crossing batch runs in full, the overshoot is logged and recorded on the run's trace, and the next LLM call is refused.
# AGENT_LOOP_MAX_DURATION_SECONDS=0    # hard per-run wall-clock budget (0 = unlimited). Folded into the run's existing deadline; the tighter bound wins.
# AGENT_LOOP_BUDGET_FINAL_ANSWER_RESERVE=0.1  # fraction of the cost/token limits held back so the closing synthesis stays affordable (clamped to [0, 0.5])
# AGENT_LOOP_BUDGET_FALLBACK_ENABLED=false   # when the COST budget refuses the next call, downgrade the run to the configured fallback model (PlatformSettings.fallback_model / DEFAULT_FALLBACK_MODEL) and CONTINUE instead of stopping. One downgrade per run, cost only (a cheaper model buys no extra tokens/tool calls/wall clock); the rest of the run is re-priced at the fallback's rates. Needs a price row for the fallback model too. Refused - and the hard stop kept - when the fallback's context window cannot hold the system prompt, when its provider caps max_tools below the run's tool surface, or when the run uses native structured output and the fallback is on another provider.
# --- Stuck-loop breaker and per-turn vision budget --- a run that
# calls the same tool with the same arguments over and over is nudged, then
# refused; images are attached to the model at most once per file per turn.
# AGENT_LOOP_IDENTICAL_CALL_WARN_AFTER=3     # identical (tool, arguments) calls in one turn before a "stop and change approach" nudge is injected (0 disables the nudge only; the refusal below still applies - set both to 0 to disable the identical-call breaker)
# AGENT_LOOP_IDENTICAL_CALL_REFUSE_AFTER=5   # identical calls before the call is refused outright (a refusal is a tool error the model reads; 0 = never refuse, nudge only)
# AGENT_LOOP_SIMILAR_CALL_WARN_AFTER=6       # near-identical calls (same file_id / url, different max_chars, offset or options) before the nudge (0 disables the nudge only; set both similar bounds to 0 to disable the similar-call breaker)
# AGENT_LOOP_SIMILAR_CALL_REFUSE_AFTER=10    # near-identical calls before the refusal (0 = never refuse, nudge only)
# AGENT_LOOP_STEP_BUDGET_NUDGE_FRACTION=0.6  # fraction of max_iterations at which the model is told what it spent its steps on and asked to finish or report (0 disables)
# AGENT_LOOP_VISION_VIEWS_PER_TURN=10        # distinct images any tool (read_file_content, browser screenshot, rendered figure, generated image) may show the model in one turn PER 25 STEPS of its step budget (an agent allowed 100 steps, or a run extended to 100, sees four times as many); past the cap a result keeps its text and loses its pixels with an explicit "vision budget exhausted" note (0 = no cap; the same file is still shown at most once per turn - a second read returns the saved notes)
# AGENT_LOOP_READ_WINDOWS_PER_FILE=4         # text windows read_file_content serves for ONE file in one turn, per view (source, or the mode="extract_structured" rendering of an HTML / JSON / JSON Lines / CSV file); the next call is an explicit error naming what was read and the ways forward (the rendered view, code_interpreter where conversation files are mounted), never another window. Images are never counted (0 = no cap; negative refused)
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# CODE_INTERPRETER_EXTRA_ALLOWED_MODULES=  # CSV of blocked modules (stdlib or third-party, e.g. socket,http,requests) to re-enable in the code interpreter sandbox. Sandbox-escape modules (subprocess, ctypes, importlib, pickle, ...) can never be re-enabled.
# CUSTOM_TOOL_EXTRA_ALLOWED_MODULES=       # CSV of modules to re-enable in the custom tool Python sandbox (e.g. requests,urllib,http). Subprocess fallback shares the host network - prefer CUSTOM_TOOL_SANDBOX=docker. Sandbox-escape modules (subprocess, ctypes, importlib, pickle, ...) can never be re-enabled.
# --- Code interpreter sandbox workspace --- workspace/ kept between
# code_interpreter calls of a conversation or a run, in the S3 bucket under
# sandbox-workspaces/ (no volume needed). docs/docs/usage/sandbox-workspace.md
# CODE_INTERPRETER_WORKSPACE_ENABLED=true            # false = the stateless code interpreter of earlier releases
# CODE_INTERPRETER_WORKSPACE_QUOTA_MB=2048           # per workspace; a call past it saves nothing under workspace/
# CODE_INTERPRETER_WORKSPACE_MAX_FILES=20000
# CODE_INTERPRETER_WORKSPACE_IDLE_TTL_HOURS=168      # unused workspaces deleted by the hourly sweep (archive / delete: at once)
# CODE_INTERPRETER_WORKSPACE_MANIFEST_ENTRIES=40     # files the code_interpreter description lists
# CODE_INTERPRETER_WORKSPACE_CACHE_MB=2048           # local sandbox: per-process cache of downloaded contents (0 = none)
# CODE_INTERPRETER_KERNEL_IDLE_SECONDS=900           # session=true kernels stop after this idle time
# CODE_INTERPRETER_KERNEL_MAX_PER_PROCESS=8          # local sandbox: kernels per backend process
# CODE_INTERPRETER_COMMAND_MAX_SECONDS=1800          # sandbox_run_command (OpenSandbox): the longest a declared check may run
# CODE_INTERPRETER_COMMAND_ALLOW_ARGV=false          # sandbox_run_command: let an agent run an argv the checkout did not declare in .xtm-one/checks.toml
# CODE_INTERPRETER_PACKAGE_ALLOWLIST=                # CSV of packages code_interpreter(packages=...) may install (empty = installs off)
# CODE_INTERPRETER_PACKAGE_INDEX_URL=                # PEP 691 / 503 simple index (empty = PyPI)

# --- URL guard (deterministic hallucinated-link post-processor) ---
# URL_GUARD_ENABLED=true
# URL_GUARD_MANIFEST_PATH=               # optional path to a custom allowed-URL manifest

# --- Nova prompt-safety engine --- read only while the Nova integration
# is connected and its full engine (nova-hunting) is installed; the built-in
# keyword tier makes no provider call. Pattern embeddings are kept per model,
# so only the screened message is embedded on each evaluation.
# NOVA_EVALUATION_CONCURRENCY=4          # provider calls one evaluation runs at once (llm: conditions, pattern embeddings not cached yet); same calls, same verdicts, 1 = one after another (1-32)
# NOVA_LLM_MAX_CONDITIONS=0              # most distinct llm: conditions asked per evaluation; 0 = every condition (default). A ceiling leaves the rest unasked (the conditions of block rules are kept first), logged once per rule set and shown by the Security Audit

# --- Microsoft Teams message listings ---
# MICROSOFT_TEAMS_MESSAGE_TEXT_LIMIT=4000  # longest text of one message the Teams channel / chat listings show; a longer one is cut at a word boundary and names the get_microsoft_channel_message / get_microsoft_chat_message call that reads it in full. A listing's messages also share one text budget, so on a busy channel long messages are cut shorter while short ones stay whole (positive integer)

# --- Auth / account lifecycle ---
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# MIN_PASSWORD_LENGTH=8                  # clamped to [1, 1024]
# INVITATION_EXPIRE_HOURS=168            # clamped to [1, 720]
# PASSWORD_RESET_EXPIRE_HOURS=24         # clamped to [1, 720]
# API_KEY_MAX_LIFETIME_DAYS=0            # longest a personal API key created or re-dated may live; 0 = no maximum, clamped to [0, 3650]. Existing keys keep their expiry
# Web sessions, also in Settings > Security: a session ends this long after its
# sign-in, even in use, and after this long without activity (0 = no idle timeout).
# The idle timeout needs Redis and is not enforced while Redis is unreachable.
# JWT_EXPIRE_MINUTES=10080               # absolute session lifetime, 7 days; clamped to [1, 525600]
# SESSION_IDLE_TIMEOUT_MINUTES=0         # idle timeout; 0 = off, else clamped to [5, 525600]

# --- Terms of Use acceptance gate ---
# A blocking consent screen shown after authentication until the user
# explicitly accepts the current Terms of Use. Acceptance is recorded server
# side (user, version, timestamp) and admins see it on the Users pages.
# Only active where Agentic AI is licensed — Community Edition is never gated.
# TERMS_OF_USE_ENABLED=true              # set to false for self-hosted / on-prem deployments that handle ToU acceptance outside the product
# TERMS_OF_USE_VERSION=2026-07-14        # identity of the published document; CHANGING IT RE-OPENS THE GATE FOR EVERY USER on their next request (that is how a ToU revision is rolled out). An empty value disables the gate.
# TERMS_OF_USE_URL=https://filigran.io/ai-terms/   # where the document itself is published; opened in a new tab from the consent screen
# TERMS_OF_USE_EXEMPT_EMAILS=                      # comma-separated emails never gated (exact, case-insensitive): the vendor accounts operating a SaaS instance sign in without accepting on the customer's behalf. Such an address cannot be taken by sign-up or a profile email change.

# --- Usage telemetry ---
# Anonymous usage metrics sent to Filigran every 6 hours (docs/docs/deployment/telemetry.md
# lists them). false = no connection to the collector at all.
# TELEMETRY_ENABLED=true                  # master switch for the anonymous usage telemetry (false = nothing is sent)
# TELEMETRY_ENDPOINT=                    # override the telemetry endpoint (empty = default)

# --- XTM One Runners (native, pull-based OS-control daemons) ---
# A downloadable native daemon a user installs on a machine they control,
# enrolls once, and leaves running. It PULLS commands over an outbound-only
# connection (the platform never dials in) and gives agents full-desktop
# screenshots, real-browser control, shell + file ops and synthetic input via
# the `computer_use` built-in tool. The runner installers and self-update
# artifacts are BUILT BY THE RELEASE PIPELINE AND EMBEDDED IN THE PLATFORM
# IMAGE - every instance serves its own version-matched downloads from
# Profile > Runners; there is no external download URL to configure.
# See docs/deployment/configuration.md.
# RUNNERS_ENABLED=true                    # master switch for enrollment, transport, and the computer_use tools
# RUNNER_DIST_DIR=runner_dist            # directory of the embedded runner distribution inside the image (populated by CI at image build; empty on source builds, which reports downloads as unavailable)
# RUNNER_MIN_SUPPORTED_VERSION=          # minimum runner binary version accepted at connect (empty = no floor). Format: MAJOR.YYMMDD.SEQ
# RUNNER_MAX_PER_USER=200                # cap on ACTIVE runners per user / company-managed fleet, enforced at enrollment (0 = unlimited)
# RUNNER_MAX_INFLIGHT_COMMANDS=10        # cap on concurrent in-flight commands per runner; a burst past this gets a transient "busy" (0 = unlimited)
# Also in Settings > Security: this variable, when set, wins and locks the field there.
# RUNNER_STRICT_PATH_CONFINEMENT=false   # true = refuse a restricted runner's file command whose path leads outside its allowed folders through a link; false (default) = run it as before, with a warning in its result; it also covers a file that is not a regular file (a device, a named pipe, a socket, as the OS reports what the command opened) on every runner (true = refused)
# RUNNER_RESULT_WAIT_TIMEOUT_SECONDS=    # how long a computer_use call waits for a command's result; unset (default) = as long as the machine may take to report it, from delivery (205 s with the default 120 s command timeout); a number = a fixed wait from dispatch (the old default was 180). Never past the agent run's limit for one tool call
# Transport tuning knobs (rarely need changing):
# RUNNER_COMMAND_DEFAULT_TIMEOUT_SECONDS=120   # execution budget every command is handed; the machine stops it at budget + 30 s, and the redelivery lease and the default result wait follow it
# RUNNER_HEARTBEAT_INTERVAL_SECONDS=30   # heartbeat / WebSocket keepalive cadence the runner is told to use
# RUNNER_OFFLINE_AFTER_SECONDS=75        # a runner not heard from for this long is offline (keep it a small multiple of the heartbeat)
# RUNNER_LONG_POLL_TIMEOUT_SECONDS=25    # how long the long-poll fallback holds a request waiting for a command
# RUNNER_MAX_RESULT_BYTES=25000000       # largest screenshot / file-read result a runner may upload
# RUNNER_ENROLLMENT_TTL_SECONDS=900      # lifetime of a single-use enrollment key

# --- XTM One Relays (on-prem, pull-based egress proxies) ---
# A separate binary an administrator installs inside a customer network (Linux,
# Windows, macOS, Docker, Kubernetes). It opens an OUTBOUND connection to the
# platform and carries the HTTP requests of the integrations, MCP servers and
# flow HTTP nodes routed through its relay group to the on-prem tools they call
# (Splunk, Tanium, ...). The platform never dials in. The installers and the
# self-update artifacts are built by the release pipeline and embedded in the
# platform image, like the runner's. See docs/deployment/configuration.md.
# RELAYS_ENABLED=true                    # master switch for relay groups, enrollment, the relay transport and routing (false removes the subsystem)
# RELAY_MIN_SUPPORTED_VERSION=           # minimum relay version accepted at connect (empty = no floor). Format: MAJOR.YYMMDD.SEQ
# RELAY_MAX_PER_GROUP=50                 # cap on relays enrolled in one group (0 = unlimited)
# RELAY_REQUEST_LOG_RETENTION_DAYS=30    # days the metadata of relayed requests (never bodies) is kept (0 = forever)
# RELAY_DIST_DIR=relay_dist              # directory of the embedded relay distribution inside the image (populated by CI at image build; empty on source builds)
# Transport tuning knobs (rarely need changing):
# RELAY_HEARTBEAT_INTERVAL_SECONDS=20    # heartbeat cadence the relay is told to use
# RELAY_OFFLINE_AFTER_SECONDS=60         # a relay not heard from for this long is offline; a group with none online fails its requests at once
# RELAY_LONG_POLL_TIMEOUT_SECONDS=25     # how long the long-poll fallback holds a request waiting for work
# RELAY_QUEUE_TIMEOUT_SECONDS=30         # how long a request waits for a relay of its group to pick it up
# RELAY_STREAM_IDLE_TIMEOUT_SECONDS=120  # a relayed stream silent this long in both directions is abandoned
# RELAY_MAX_REQUEST_BYTES=20000000       # largest request body a relay carries
# RELAY_MAX_RESPONSE_BYTES=100000000     # largest response body a relay carries (the relay cuts a larger one with too_large)
# RELAY_ENROLLMENT_TTL_SECONDS=3600      # default lifetime of an enrollment key

# --- Redis (docker-compose) ---
# REDIS_MAXMEMORY=512mb                  # consumed by docker-compose.yml for the Redis container
