{
  "name": "@filigran-copilot/microsoft-office",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && vitest run",
    "sideload": "npx office-addin-debugging start manifest/manifest.xml --app word",
    "sideload:excel": "npx office-addin-debugging start manifest/manifest.xml --app excel",
    "sideload:ppt": "npx office-addin-debugging start manifest/manifest.xml --app powerpoint",
    "sideload:stop": "npx office-addin-debugging stop manifest/manifest.xml"
  },
  "dependencies": {
    "@filigran/chatbot": "7.0.0",
    "@filigran/design-system": "1.9.0",
    "lucide-react": "0.577.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/office-js": "1.0.591",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-mkcert": "2.0.0",
    "vitest": "5.0.2"
  }
}
